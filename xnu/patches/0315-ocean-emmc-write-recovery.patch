+/* After a failed command: reset the host CMD/DAT state machines, stop a
+ * card left waiting in data/receive state, then wait for transfer state. */
+static int recover(void) {
+    *(volatile uint8_t *)(ocean_regs + 0x2f) = 0x06; /* RESET_CMD | RESET_DATA. */
+    __asm__ volatile("dsb sy" ::: "memory");
+    uint64_t start = ticks();
+    while (r8(0x2f) & 0x06) {
+        if (ticks() - start > 1920000ULL) { return ETIMEDOUT; }
+    }
+    w32(0x30, 0xffffffffU);
+    start = ticks();
+    int error;
+    while ((error = command(13, 1U << 16, NULL)) != 0) {
+        unsigned int state = (ocean_last_r1 >> 9) & 15;
+        if (error == EBUSY && (state == 5 || state == 6)) {
+            command(12, 0, NULL);
+        }
+        if (ticks() - start >= 19200000ULL * 2) {
+            printf("OCEAN SDHCI: recovery failed (%d) R1=0x%x\n", error, ocean_last_r1);
+            return error;
+        }
+        __asm__ volatile("yield");
+    }
+    return 0;
+}
