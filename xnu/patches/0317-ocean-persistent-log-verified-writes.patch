+/* R1 bits eMMC reports for the PREVIOUS command (COM_CRC_ERROR,
+ * ILLEGAL_COMMAND). test21 printed CMD24 R1 errors yet kept booting. */
+#define OCEAN_R1_PREVIOUS 0x00c00000U
+static uint32_t ocean_stale_r1_logged;
+
+/* Callers fence lba; ocean_sd_lock held. */
+static int program_sector(uint64_t lba, const uint8_t *data) {
+    uint8_t buffer[512], check[512];
+    memcpy(buffer, data, 512);
+    int error = 0;
+    for (int attempt = 0; attempt < 3; attempt++) {
+        error = command(24, (uint32_t)lba, buffer);
+        uint32_t r1 = ocean_last_r1;
+        if (!error || error == EIO) {
+            /* Transfer complete covers DAT0 busy; also wait for the card to
+             * leave the programming state before the next command. */
+            int ready;
+            uint64_t start = ticks();
+            while ((ready = command(13, 1U << 16, NULL)) == EBUSY) {
+                if (ticks() - start >= 19200000ULL * 2) { ready = ETIMEDOUT; break; }
+                __asm__ volatile("yield");
+            }
+            if (!error && !ready) { return 0; }
+            if (error == EIO && !ready && !(r1 & 0xfff80000U & ~OCEAN_R1_PREVIOUS) &&
+                !command(17, (uint32_t)lba, check) && !memcmp(check, buffer, 512)) {
+                if (ocean_stale_r1_logged++ < 32) {
+                    printf("OCEAN SDHCI: CMD24 lba=%llu R1=0x%x previous-command flag, data verified\n",
+                        lba, r1);
+                }
+                return 0;
+            }
+            if (!error) { error = ready; }
+        }
+        printf("OCEAN SDHCI: CMD24 lba=%llu attempt %d failed (%d) R1=0x%x\n",
+            lba, attempt + 1, error, r1);
+        if (recover()) { break; }
+    }
+    return error;
+}
