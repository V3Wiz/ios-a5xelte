     .d_mmap=eno_mmap,.d_strategy=eno_strat,.d_reserved_1=eno_getc,.d_reserved_2=eno_putc,.d_type=D_DISK };
+/*
+ * Persistent console log ("oceanlog"): every 2 s the new part of the console
+ * ring is written to the last 4 MiB + 512 B of userdata, far beyond the
+ * 20 GiB HFSX volume at its start. Sector 0 of that area is a header:
+ *   "OCEANLG1" | u32 version 1 | u32 ring size | u64 total bytes | u64 seq
+ * ring offset of byte n = n % ring size. Read it from TWRP with
+ * tools/ocean-log-pull.py. Needs ocean_emmcwrite=1; oceanlog=0 disables it.
+ */
+#define OCEAN_LOG_RING     (4u << 20)
+#define OCEAN_LOG_SECTORS  (1u + OCEAN_LOG_RING / 512u)
+#define OCEAN_LOG_FIRST    (OCEAN_USERDATA_LAST + 1 - OCEAN_LOG_SECTORS)
+static int ocean_log_chan;
+
+struct ocean_log_header {
+    char magic[8];
+    uint32_t version, size;
+    uint64_t total, seq;
+};
+
+static int log_write_sector(uint64_t lba, const uint8_t *data) {
+    /* Fence: only the log area, never the HFS volume. */
+    if (!ocean_writable || lba < OCEAN_LOG_FIRST || lba > OCEAN_USERDATA_LAST ||
+        lba < ocean_first + ocean_length) {
+        return EROFS;
+    }
+    return program_sector(lba, data);
+}
+
+static void log_thread(__unused void *arg, __unused wait_result_t wr) {
+    const char *ring;
+    uint32_t rsize;
+    uint64_t total, flushed = 0, seq = 0;
+    uint8_t sector[512];
+    for (;;) {
+        (void)tsleep(&ocean_log_chan, PZERO, "oceanlog", hz * 2);
+        a5xelte_log_snapshot(&ring, &rsize, &total);
+        if (total == flushed || rsize != OCEAN_LOG_RING) { continue; }
+        uint64_t pos = total - flushed >= rsize ? total - rsize : flushed;
+        int error = 0;
+        lck_mtx_lock(&ocean_sd_lock);
+        while (pos < total && !error) {
+            uint32_t block = (uint32_t)((pos % rsize) / 512u);
+            memcpy(sector, ring + (size_t)block * 512u, 512u);
+            error = log_write_sector(OCEAN_LOG_FIRST + 1u + block, sector);
+            pos += 512u - (pos & 511u);
+        }
+        if (!error) {
+            struct ocean_log_header h = {
+                .magic = { 'O', 'C', 'E', 'A', 'N', 'L', 'G', '1' },
+                .version = 1, .size = rsize, .total = total, .seq = ++seq,
+            };
+            memset(sector, 0, sizeof(sector));
+            memcpy(sector, &h, sizeof(h));
+            error = log_write_sector(OCEAN_LOG_FIRST, sector);
+        }
+        lck_mtx_unlock(&ocean_sd_lock);
+        if (error) {
+            printf("OCEAN LOG: write failed (%d), stopping\n", error);
+            return;
+        }
+        flushed = total;
+    }
+}
+
+static void log_start(void) {
+    int enabled = 1;
+    thread_t thread;
+    PE_parse_boot_argn("oceanlog", &enabled, sizeof(enabled));
+    if (!enabled || !ocean_writable) { return; }
+    printf("OCEAN LOG: console ring to userdata sectors %llu..%llu\n",
+        (uint64_t)OCEAN_LOG_FIRST, (uint64_t)OCEAN_USERDATA_LAST);
+    if (kernel_thread_start(log_thread, NULL, &thread) == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    }
+}
