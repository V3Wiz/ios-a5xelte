+/* Explicit opt-in selects only the verified userdata geometry. */
+static bool root_candidate(const char *name, uint64_t first, uint64_t last, int optin) {
+    if (!strcmp(name, "userdata")) {
+        return optin == 1 && first == 15826944ULL && last == 122142686ULL;
+    }
+    return !strcmp(name, "IOS") || !strcmp(name, "ios") || !strcmp(name, "OCEAN_IOS");
+}
+static uint32_t hfs_be32(const uint8_t *p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+        ((uint32_t)p[2] << 8) | p[3];
+}
+static int root_volume(const uint8_t *v, uint64_t sectors, bool userdata, uint64_t *length) {
+    unsigned int version = ((unsigned int)v[2] << 8) | v[3];
+    if (v[0] != 'H' || !((v[1] == 'X' && version == 5) ||
+        (v[1] == '+' && version == 4))) { return EINVAL; }
+    uint32_t block = hfs_be32(v + 40), count = hfs_be32(v + 44);
+    if (block < 512 || block > 65536 || (block & (block - 1)) ||
+        count < 2 || hfs_be32(v + 48) > count) { return EINVAL; }
+    uint64_t bytes = (uint64_t)block * count;
+    if (bytes / 512 > sectors) { return EINVAL; }
+    if (userdata && (v[1] != 'X' || block != 4096 || count != 5242880)) { return EINVAL; }
+    *length = bytes / 512;
+    return 0;
+}
