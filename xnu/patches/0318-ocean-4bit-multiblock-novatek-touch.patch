diff --git a/bsd/dev/ocean_touch.c b/bsd/dev/ocean_touch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/ocean_touch.c
@@ -0,0 +1,250 @@
+/* OCEAN Novatek NT36xxx touch over BLSP1 QUP3 I2C (78b7000), polled.
+ *
+ * Moto ocean live FDT: /soc/i2c@78b7000/novatek@62 ("novatek,NVT-ts"),
+ * irq gpio 65, max 720x1520, no supplies (TDDI: powered with the panel).
+ * Motorola's nt36xxx.c reads the event buffer with CTP_I2C_READ at
+ * I2C_FW_Address 0x01: write register 0x00, repeated start, read; each
+ * finger is 6 bytes (id<<3|status, x>>4, y>>4, x&15<<4|y&15, w, p).
+ * QUP register use follows Motorola's i2c-msm-v2.c FIFO mode (tags v2,
+ * 2-byte input tag per read chunk). Clocks: BLSP1 AHB vote bit 10,
+ * BLSP1_QUP3_I2C_APPS RCG 0x4000 / CBCR 0x4020; pins gpio10/11 function 2.
+ *
+ * The only bytes sent to the touch chip are its event register address.
+ * Boot-arg ocean_touch=1 enables it.
+ */
+#if defined(ARM64_BOARD_CONFIG_OCEAN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void ocean_touch_start(void);
+
+#define QUP_PA          0x078b7000
+#define GCC_PA          0x01800000
+#define TLMM_PA         0x01000000
+#define NVT_ADDR        0x01            /* I2C_FW_Address */
+#define NVT_FINGERS     5
+#define NVT_READ        (NVT_FINGERS * 6)
+#define NVT_MAX_X       720
+#define NVT_MAX_Y       1520
+/* Same mapping as the display: iPhone X canvas scaled to 704x1520 at x=8. */
+#define CANVAS_W        1125
+#define CANVAS_H        2436
+#define SCAN_W          704
+#define SCAN_X          8
+
+enum {
+    QUP_CONFIG = 0x0, QUP_STATE = 0x4, QUP_IO_MODES = 0x8, QUP_SW_RESET = 0xc,
+    QUP_OPERATIONAL = 0x18, QUP_ERROR_FLAGS = 0x1c, QUP_ERROR_FLAGS_EN = 0x20,
+    QUP_OPERATIONAL_MASK = 0x28, QUP_MX_OUTPUT_COUNT = 0x100,
+    QUP_OUT_FIFO_BASE = 0x110, QUP_MX_WRITE_COUNT = 0x150,
+    QUP_MX_INPUT_COUNT = 0x200, QUP_MX_READ_COUNT = 0x208, QUP_IN_FIFO_BASE = 0x218,
+    QUP_I2C_MASTER_CLK_CTL = 0x400, QUP_I2C_STATUS = 0x404, QUP_I2C_MASTER_CONFIG = 0x408,
+};
+
+static vm_offset_t qup;
+static int touch_chan;
+static uint32_t touch_errors;
+
+static uint32_t qr(unsigned int off) { return *(volatile uint32_t *)(qup + off); }
+static void qw(unsigned int off, uint32_t v) {
+    *(volatile uint32_t *)(qup + off) = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static uint64_t ticks(void) {
+    uint64_t n;
+    __asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(n));
+    return n;
+}
+
+static int qup_state(uint32_t state) {
+    qw(QUP_STATE, state);
+    uint64_t start = ticks();
+    for (;;) {
+        uint32_t s = qr(QUP_STATE);
+        if ((s & 4) && (s & 3) == state) { return 0; }
+        if (ticks() - start > 1920000ULL) {
+            printf("OCEAN TOUCH: QUP state %u timeout (state=0x%x)\n", state, s);
+            return ETIMEDOUT;
+        }
+    }
+}
+
+static int clocks_and_pins(void) {
+    volatile uint32_t *gcc = (volatile uint32_t *)ml_io_map(GCC_PA, 0x80000);
+    volatile uint32_t *pin10 = (volatile uint32_t *)ml_io_map(TLMM_PA + 10 * 0x1000, 0x1000);
+    volatile uint32_t *pin11 = (volatile uint32_t *)ml_io_map(TLMM_PA + 11 * 0x1000, 0x1000);
+    if (!gcc || !pin10 || !pin11) { return ENXIO; }
+    printf("OCEAN TOUCH: before vote=%x rcg=%x/%x cbcr=%x gpio10=%x gpio11=%x\n",
+        gcc[0x45004 / 4], gcc[0x4000 / 4], gcc[0x4004 / 4], gcc[0x4020 / 4], pin10[0], pin11[0]);
+    gcc[0x45004 / 4] |= 1U << 10;               /* BLSP1 AHB vote. */
+    __asm__ volatile("dsb sy" ::: "memory");
+    if ((gcc[0x4004 / 4] & 0x71f) != 0) {      /* RCG: XO, no divider. */
+        gcc[0x4004 / 4] &= ~0x371fU;
+        __asm__ volatile("dsb sy" ::: "memory");
+        gcc[0x4000 / 4] |= 1;
+        uint64_t start = ticks();
+        while (gcc[0x4000 / 4] & 1) {
+            if (ticks() - start > 1920000ULL) { return ETIMEDOUT; }
+        }
+    }
+    gcc[0x4020 / 4] |= 1;                       /* QUP3 I2C apps clock on. */
+    __asm__ volatile("dsb sy" ::: "memory");
+    uint64_t start = ticks();
+    while (gcc[0x4020 / 4] & 0x80000000U) {
+        if (ticks() - start > 1920000ULL) {
+            printf("OCEAN TOUCH: QUP3 clock stays off cbcr=%x\n", gcc[0x4020 / 4]);
+            return ETIMEDOUT;
+        }
+    }
+    /* Function 2 (blsp_i2c3), 2 mA, no pull: as the FDT i2c_3_active state. */
+    pin10[0] = (pin10[0] & ~0x3ffU) | (2U << 2);
+    pin11[0] = (pin11[0] & ~0x3ffU) | (2U << 2);
+    __asm__ volatile("dsb sy" ::: "memory");
+    printf("OCEAN TOUCH: after vote=%x rcg=%x/%x cbcr=%x gpio10=%x gpio11=%x\n",
+        gcc[0x45004 / 4], gcc[0x4000 / 4], gcc[0x4004 / 4], gcc[0x4020 / 4], pin10[0], pin11[0]);
+    return 0;
+}
+
+static int qup_init(void) {
+    qup = ml_io_map(QUP_PA, 0x600);
+    if (!qup) { return ENXIO; }
+    qw(QUP_SW_RESET, 1);
+    int error = qup_state(0);
+    if (error) { return error; }
+    qw(QUP_CONFIG, 0x200 | 7);                  /* I2C mini-core, N=8 bits. */
+    qw(QUP_ERROR_FLAGS_EN, 0x3c);
+    qw(QUP_OPERATIONAL_MASK, (1U << 9) | (1U << 8));
+    qw(QUP_I2C_MASTER_CONFIG, 1);               /* Tags version 2. */
+    printf("OCEAN TOUCH: QUP state=%x io_modes=%x i2c_status=%x\n",
+        qr(QUP_STATE), qr(QUP_IO_MODES), qr(QUP_I2C_STATUS));
+    return 0;
+}
+
+/* Write register reg, repeated start, read n bytes from addr (n <= 64). */
+static int i2c_read(uint8_t addr, uint8_t reg, uint8_t *data, unsigned int n) {
+    uint8_t out[12] = {
+        0x81, (uint8_t)(addr << 1), 0x82, 1, reg,           /* START, WRITE 1 */
+        0x81, (uint8_t)((addr << 1) | 1), 0x87, (uint8_t)n, /* START, READ_N_STOP */
+    };
+    unsigned int out_len = 9, in_len = n + 2;   /* 2-byte input tag. */
+    int error = qup_state(0);
+    if (error) { return error; }
+    qw(QUP_MX_INPUT_COUNT, 0);
+    qw(QUP_MX_OUTPUT_COUNT, 0);
+    qw(QUP_MX_READ_COUNT, in_len);
+    qw(QUP_MX_WRITE_COUNT, out_len);
+    qw(QUP_CONFIG, 0x200 | 7);
+    qw(QUP_IO_MODES, (qr(QUP_IO_MODES) & ~0x1fc00U) | (1U << 15) | (1U << 14));
+    qw(QUP_OPERATIONAL_MASK, 0);
+    if ((error = qup_state(1))) { return error; }
+    qw(QUP_I2C_MASTER_CLK_CTL, (62U << 16) | 124U); /* 100 kHz from 19.2 MHz. */
+    if ((error = qup_state(3))) { return error; }
+    for (unsigned int i = 0; i < out_len; i += 4) {
+        uint32_t word;
+        memcpy(&word, out + i, 4);
+        qw(QUP_OUT_FIFO_BASE, word);
+    }
+    if ((error = qup_state(1))) { return error; }
+    uint8_t in[72];
+    unsigned int got = 0;
+    uint64_t start = ticks();
+    while (got < in_len) {
+        uint32_t status = qr(QUP_I2C_STATUS), flags = qr(QUP_ERROR_FLAGS);
+        if ((status & 0x380003cU) || (flags & 0x3cU)) {
+            if (touch_errors++ < 6) {
+                printf("OCEAN TOUCH: I2C error status=%x flags=%x op=%x got=%u\n",
+                    status, flags, qr(QUP_OPERATIONAL), got);
+            }
+            qw(QUP_ERROR_FLAGS, flags);
+            qup_state(0);
+            return EIO;
+        }
+        if (qr(QUP_OPERATIONAL) & (1U << 5)) {  /* Input FIFO not empty. */
+            uint32_t word = qr(QUP_IN_FIFO_BASE);
+            unsigned int take = MIN(4U, in_len - got);
+            memcpy(in + got, &word, take);
+            got += take;
+            continue;
+        }
+        if (ticks() - start > 1920000ULL) {     /* 100 ms. */
+            if (touch_errors++ < 6) {
+                printf("OCEAN TOUCH: I2C timeout status=%x op=%x got=%u\n",
+                    status, qr(QUP_OPERATIONAL), got);
+            }
+            qup_state(0);
+            return ETIMEDOUT;
+        }
+    }
+    qw(QUP_OPERATIONAL, qr(QUP_OPERATIONAL) & 0xf00U); /* Clear service/done flags. */
+    qup_state(0);
+    memcpy(data, in + 2, n);
+    return 0;
+}
+
+static void touch_thread(__unused void *arg, __unused wait_result_t wr) {
+    uint8_t buf[NVT_READ];
+    bool down[NVT_FINGERS] = { false };
+    unsigned int logged = 0, ok = 0;
+    if (clocks_and_pins() || qup_init()) {
+        printf("OCEAN TOUCH: controller setup failed\n");
+        return;
+    }
+    uint8_t fw[2];
+    if (!i2c_read(NVT_ADDR, 0x78, fw, sizeof(fw))) {    /* EVENT_MAP_FWINFO */
+        printf("OCEAN TOUCH: Novatek fw info %02x %02x\n", fw[0], fw[1]);
+    }
+    for (;;) {
+        (void)tsleep(&touch_chan, PZERO, "oceantouch", MAX(1, hz / 50));
+        if (i2c_read(NVT_ADDR, 0x00, buf, sizeof(buf))) {
+            if (touch_errors > 6) { (void)tsleep(&touch_chan, PZERO, "oceantouch", hz); }
+            continue;
+        }
+        if (ok++ == 0 || (logged < 8 && (buf[0] & 7))) {
+            logged++;
+            printf("OCEAN TOUCH: raw %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x\n",
+                buf[0], buf[1], buf[2], buf[3], buf[4], buf[5],
+                buf[6], buf[7], buf[8], buf[9], buf[10], buf[11]);
+        }
+        bool seen[NVT_FINGERS] = { false };
+        for (unsigned int i = 0; i < NVT_FINGERS; i++) {
+            const uint8_t *p = buf + 6 * i;
+            unsigned int id = p[0] >> 3, status = p[0] & 7;
+            if (id == 0 || id > NVT_FINGERS || (status != 1 && status != 2)) { continue; }
+            int x = (p[1] << 4) | (p[3] >> 4), y = (p[2] << 4) | (p[3] & 15);
+            if (x >= NVT_MAX_X || y >= NVT_MAX_Y) { continue; }
+            int lx = (x - SCAN_X) * CANVAS_W / SCAN_W, ly = y * CANVAS_H / NVT_MAX_Y;
+            lx = lx < 0 ? 0 : (lx >= CANVAS_W ? CANVAS_W - 1 : lx);
+            seen[id - 1] = true;
+            down[id - 1] = true;
+            sweet_hid_touch((int)id - 1, 1, lx, ly);
+        }
+        for (unsigned int f = 0; f < NVT_FINGERS; f++) {
+            if (down[f] && !seen[f]) {
+                down[f] = false;
+                sweet_hid_touch((int)f, 0, 0, 0);
+            }
+        }
+    }
+}
+
+void ocean_touch_start(void) {
+    int enabled = 0;
+    thread_t thread;
+    PE_parse_boot_argn("ocean_touch", &enabled, sizeof(enabled));
+    if (enabled != 1) { return; }
+    printf("OCEAN TOUCH: Novatek poll thread starting\n");
+    if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    }
+}
+#endif
