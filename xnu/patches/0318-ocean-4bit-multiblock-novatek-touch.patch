+static int wait_transfer_state(void) {
+    uint64_t start = ticks();
+    int error;
+    while ((error = command(13, 1U << 16, NULL)) == EBUSY) {
+        if (ticks() - start >= 19200000ULL * 2) { return ETIMEDOUT; }
+        __asm__ volatile("yield");
+    }
+    return error;
+}
+
+/* Boot-arg ocean_4bit=1: EXT_CSD BUS_WIDTH 4-bit (default-speed timing
+ * unchanged). The GPT header must read back identically, else revert. */
+static void bus_width_4(void) {
+    int optin = 0;
+    PE_parse_boot_argn("ocean_4bit", &optin, sizeof(optin));
+    if (optin != 1) { return; }
+    uint8_t before[512], after[512];
+    if (read_sector(1, before)) { return; }
+    int error = command(6, 0x03b70100U, NULL);
+    if (!error) { error = wait_transfer_state(); }
+    if (!error && (ocean_last_r1 & 0x80)) { error = EIO; } /* SWITCH_ERROR */
+    if (!error) {
+        w8(0x28, r8(0x28) | 0x02); /* Host 4-bit data width. */
+        error = read_sector(1, after);
+        if (!error && memcmp(before, after, sizeof(before))) { error = EIO; }
+    }
+    if (error) {
+        printf("OCEAN SDHCI: 4-bit bus failed (%d) R1=0x%x, back to 1-bit\n", error, ocean_last_r1);
+        w8(0x28, r8(0x28) & ~0x02);
+        recover();
+        command(6, 0x03b70000U, NULL);
+        wait_transfer_state();
+        return;
+    }
+    printf("OCEAN SDHCI: 4-bit data bus\n");
+}
+
+/* READ_MULTIPLE_BLOCK with Auto CMD12, PIO, 2..128 sectors. */
+#define OCEAN_MULTI_MAX 128
+static bool ocean_multiblock;
+static uint32_t ocean_multi_failures;
+
+static int read_blocks(uint64_t lba, uint32_t n, uint8_t *data) {
+    if (n < 2 || n > OCEAN_MULTI_MAX || lba + n > ocean_sectors || lba + n > UINT32_MAX) {
+        return EINVAL;
+    }
+    uint64_t start = ticks();
+    while (r32(0x24) & 3U) {
+        if (ticks() - start >= 19200000ULL * 2) { return EBUSY; }
+        __asm__ volatile("yield");
+    }
+    w32(0x30, 0xffffffffU);
+    w16(0x04, 512);
+    w16(0x06, (uint16_t)n);
+    w16(0x0c, 0x36); /* Multi, read, Auto CMD12, block count. */
+    w32(0x08, (uint32_t)lba);
+    __asm__ volatile("dsb sy" ::: "memory");
+    w16(0x0e, (uint16_t)((18U << 8) | 0x3aU));
+    int error = wait_status(1);
+    if (error) { return error; }
+    uint32_t response = r32(0x10);
+    w32(0x30, 1);
+    if (response & 0xfff80000U) { return EIO; }
+    for (uint32_t b = 0; b < n; b++) {
+        error = wait_status(0x20);
+        if (error) { return error; }
+        uint8_t *p = data + (size_t)b * 512;
+        for (unsigned int i = 0; i < 128; i++) {
+            uint32_t word = r32(0x20);
+            memcpy(p + i * 4, &word, 4);
+        }
+        w32(0x30, 0x20);
+    }
+    error = wait_status(2);
+    w32(0x30, 2);
+    return error;
+}
+
+/* Boot-arg ocean_multiread=1, enabled only if sectors 0..3 match the
+ * single-block reads. */
+static void multiblock_enable(void) {
+    int optin = 0;
+    PE_parse_boot_argn("ocean_multiread", &optin, sizeof(optin));
+    if (optin != 1) { return; }
+    static uint8_t single[4 * 512], multi[4 * 512];
+    int error = 0;
+    for (unsigned int i = 0; i < 4 && !error; i++) {
+        error = read_sector(i, single + i * 512);
+    }
+    if (!error) { error = read_blocks(0, 4, multi); }
+    if (!error && memcmp(single, multi, sizeof(single))) { error = EIO; }
+    if (error) {
+        printf("OCEAN SDHCI: multi-block reads failed (%d), single-block only\n", error);
+        recover();
+        return;
+    }
+    ocean_multiblock = true;
+    printf("OCEAN SDHCI: multi-block reads up to %u sectors\n", OCEAN_MULTI_MAX);
+}
