diff --git a/pexpert/pexpert/arm64/A5XELTE.h b/pexpert/pexpert/arm64/A5XELTE.h
--- a/pexpert/pexpert/arm64/A5XELTE.h
+++ b/pexpert/pexpert/arm64/A5XELTE.h
@@ -10,7 +10,22 @@
 #define SWEET                         1
 
 /* Firmware scanout buffer and the earliest XNU marker (physical). */
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_OCEAN)
+/* Moto XT1955-4: constants confirmed by RAM-only physical probes.
+ * Only the explicit early OCEAN branch in start.s is permitted to run.
+ * Generic A5XELTE compatibility names do not imply Samsung device support. */
+#define OCEAN                        1
+#define SWEET_SMP_MAX_CPUS            1
+#define A5XELTE_FB_PA                 0x90001000
+#define A5XELTE_FB_WIDTH              720
+#define A5XELTE_FB_HEIGHT             1520
+#define A5XELTE_FB_STRIDE             2160
+#define A5XELTE_FB_BLOCKS             3
+#define A5XELTE_FB_TEXT_SCALE         2
+#define A5XELTE_FB_DOT_PITCH          270
+#define A5XELTE_MARKER_PA             0x300ff100
+#define A5XELTE_BOOT_MPIDR            0x0
+#elif defined(ARM64_BOARD_CONFIG_HEROLTE)
 /* Galaxy S7 SM-G930F: S-Boot leaves DECON_F scanning out this buffer. */
 #define HEROLTE                       1
 /* The four Cortex-A53 "Apollo" cores, MPIDR 0x100..0x103, via PSCI CPU_ON. */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,6 +515,18 @@
 
 	mov		x20, x0
 	mov		x21, #0
+
+#if defined(OCEAN)
+    /* First real XNU instruction-path trial. Halt BEFORE the generic
+     * A5XELTE bootstrap or ANY inherited Samsung MMIO path can execute.
+     * ARM64 start.s enters with translation off; relative iso_font accesses
+     * resolve within the loaded kernel. No stack or external calls. */
+    adr x0, Locean_entry_message
+    bl Locean_entry_text
+Locean_entry_stop:
+    wfe
+    b Locean_entry_stop
+#endif
 
 #if defined(A5XELTE)
 	/* Earliest XNU-owned physical marker in preserved Samsung log RAM. */
@@ -1148,6 +1160,63 @@
 	.asciz "XNU MMU ON"
 #endif
 
+#if defined(OCEAN)
+/* 8x16 font, scale 2, BGR888. Physical bootstrap text only.
+ * All writes confined to the known splash allocation. No device registers. */
+    .align 2
+Locean_entry_text:
+    adrp x3, EXT(iso_font)@page
+    add x3, x3, EXT(iso_font)@pageoff
+    MOV64 x4, (0x90001000 + 240*2160 + 24*3)
+    mov x5, #2160
+Locean_char:
+    ldrb w6, [x0], #1
+    cbz w6, Locean_done
+    add x7, x3, x6, lsl #4
+    mov x8, #0
+Locean_row:
+    ldrb w9, [x7, x8]
+    mov x10, #0
+Locean_column:
+    mov w11, #1
+    lsl w11, w11, w10
+    tst w9, w11
+    b.eq Locean_skip
+    mov x13, #4320
+    madd x12, x8, x13, x4
+    mov x14, #6
+    madd x12, x10, x14, x12
+    mov w14, #255
+    strb w14, [x12]
+    strb w14, [x12, #1]
+    strb w14, [x12, #2]
+    strb w14, [x12, #3]
+    strb w14, [x12, #4]
+    strb w14, [x12, #5]
+    add x12, x12, x5
+    strb w14, [x12]
+    strb w14, [x12, #1]
+    strb w14, [x12, #2]
+    strb w14, [x12, #3]
+    strb w14, [x12, #4]
+    strb w14, [x12, #5]
+Locean_skip:
+    add x10, x10, #1
+    cmp x10, #8
+    b.ne Locean_column
+    add x8, x8, #1
+    cmp x8, #16
+    b.ne Locean_row
+    add x4, x4, #48
+    b Locean_char
+Locean_done:
+    dsb sy
+    ret
+Locean_entry_message:
+    .asciz "OCEAN XNU ENTRY REACHED - TEST STOP"
+    .align 2
+#endif
+
 //#include	"globals_asm.h"
 
