diff --git a/bsd/dev/ocean_gpu.c b/bsd/dev/ocean_gpu.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/ocean_gpu.c
@@ -0,0 +1,169 @@
+/* OCEAN Adreno 506 power-up probe (SDM632), boot-arg ocean_gpu=1.
+ *
+ * Step 1 of GPU acceleration, after ios-sailfish's Adreno 530 probe (0119):
+ * power and clock the GPU and read its registers. SDM632 differences, from
+ * Motorola's clock-gcc-8953.c / msm-clocks-hwio-8953.h and the live FDT:
+ *   - No separate GFX rail: oxili_gx's parent is the msm8953-gfx-ldo, which
+ *     maps every corner to bypass, so the GPU runs from VDD_CX (already on).
+ *   - GPU clocks and GDSCs are in GCC (0x1800000): GFX3D RCG 0x59000 (CFG
+ *     0x59004), branches oxili_gfx3d 0x59020, oxili_ahb 0x59028, bimc_gpu
+ *     0x59030, bimc_gfx 0x59034, oxili_timer 0x59040, oxili_aon 0x59044;
+ *     GDSCs oxili_gx 0x5901c (needs the gfx3d root forced on), oxili_cx
+ *     0x5904c.
+ *   - gfx3d at 133.33 MHz = gpll0_main_div2_mm (source 5) / 3, the lowest
+ *     GPLL-sourced level in Motorola's frequency table.
+ *   - GPU registers at 0x1c00000 (chip id 5.0.6.0), a5xx.xml dword offsets:
+ *     VBIF_VERSION 0x3000, RBBM_STATUS 0x4f5, RBBM_ALWAYSON_COUNTER_LO 0x4d2.
+ * Starts 20 s after the root mounts, with 3 s pauses between stages so the
+ * persistent log (flushed every 2 s) holds the last good stage if one hangs.
+ */
+#if defined(ARM64_BOARD_CONFIG_OCEAN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+void ocean_gpu_start(void);
+
+#define GCC_PA          0x01800000u
+#define GPU_PA          0x01c00000u
+#define GFX_LDO_PA      0x0185f000u
+
+#define GFX3D_CMD       0x59000u
+#define GFX3D_CFG       0x59004u
+#define GX_GDSC         0x5901cu
+#define CBCR_GFX3D      0x59020u
+#define CBCR_AHB        0x59028u
+#define CBCR_BIMC_GPU   0x59030u
+#define CBCR_BIMC_GFX   0x59034u
+#define CBCR_TIMER      0x59040u
+#define CBCR_AON        0x59044u
+#define CX_GDSC         0x5904cu
+
+static int gpu_chan;
+
+static void pause_s(int secs) {
+    (void)tsleep(&gpu_chan, PZERO, "oceangpu", hz * secs);
+}
+
+static uint32_t rd(vm_offset_t base, uint32_t off) {
+    uint32_t v = *(volatile uint32_t *)(base + off);
+    __asm__ volatile("dmb sy" ::: "memory");
+    return v;
+}
+
+static void wr(vm_offset_t base, uint32_t off, uint32_t v) {
+    __asm__ volatile("dmb sy" ::: "memory");
+    *(volatile uint32_t *)(base + off) = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static bool poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms) {
+    for (unsigned i = 0; i < ms * 10; i++) {
+        if ((rd(base, off) & mask) == want) { return true; }
+        delay(100);
+    }
+    return false;
+}
+
+/* Branch enable, then wait for CLK_OFF (bit 31) to clear. */
+static bool branch_on(vm_offset_t gcc, uint32_t off) {
+    wr(gcc, off, rd(gcc, off) | 1u);
+    return poll(gcc, off, 1u << 31, 0, 10);
+}
+
+/* GDSC on: clear SW_COLLAPSE (bit 0), wait for PWR_ON (bit 31). */
+static bool gdsc_on(vm_offset_t gcc, uint32_t off) {
+    wr(gcc, off, rd(gcc, off) & ~1u);
+    return poll(gcc, off, 1u << 31, 1u << 31, 10);
+}
+
+static void dump(vm_offset_t gcc, vm_offset_t ldo, const char *when) {
+    printf("OCEAN GPU: %s cx_gdsc %08x gx_gdsc %08x gfx3d_rcg %08x/%08x gfx3d %08x ahb %08x "
+        "bimc_gpu %08x bimc_gfx %08x timer %08x aon %08x ldo %08x %08x %08x\n",
+        when, rd(gcc, CX_GDSC), rd(gcc, GX_GDSC), rd(gcc, GFX3D_CMD), rd(gcc, GFX3D_CFG),
+        rd(gcc, CBCR_GFX3D), rd(gcc, CBCR_AHB), rd(gcc, CBCR_BIMC_GPU), rd(gcc, CBCR_BIMC_GFX),
+        rd(gcc, CBCR_TIMER), rd(gcc, CBCR_AON), rd(ldo, 0x0), rd(ldo, 0x4), rd(ldo, 0x8));
+}
+
+static void gpu_thread(__unused void *arg, __unused wait_result_t wr_result) {
+    pause_s(20);
+    vm_offset_t gcc = ml_io_map(GCC_PA, 0x80000);
+    vm_offset_t ldo = ml_io_map(GFX_LDO_PA, 0x1000);
+    if (!gcc || !ldo) {
+        printf("OCEAN GPU: map failed\n");
+        return;
+    }
+
+    /* 1. Read-only state as the bootloader left it. */
+    dump(gcc, ldo, "at boot:");
+    pause_s(3);
+
+    /* 2. CX side: GDSC, then the AHB and memory-interface clocks. */
+    bool cx = gdsc_on(gcc, CX_GDSC);
+    bool ahb = branch_on(gcc, CBCR_AHB);
+    bool bimc_gpu = branch_on(gcc, CBCR_BIMC_GPU);
+    bool bimc_gfx = branch_on(gcc, CBCR_BIMC_GFX);
+    printf("OCEAN GPU: cx_gdsc %s ahb %s bimc_gpu %s bimc_gfx %s\n", cx ? "on" : "TIMEOUT",
+        ahb ? "on" : "OFF", bimc_gpu ? "on" : "OFF", bimc_gfx ? "on" : "OFF");
+    pause_s(3);
+
+    /* 3. gfx3d = 133.33 MHz (gpll0_main_div2_mm / 3), root forced on for the
+     * GX GDSC (FDT qcom,force-enable-root-clk). */
+    wr(gcc, GFX3D_CFG, (5u << 8) | 5u);
+    wr(gcc, GFX3D_CMD, rd(gcc, GFX3D_CMD) | 1u);
+    bool rcg = poll(gcc, GFX3D_CMD, 1u, 0, 10);
+    wr(gcc, GFX3D_CMD, rd(gcc, GFX3D_CMD) | 2u);
+    bool root = poll(gcc, GFX3D_CMD, 1u << 31, 0, 10);
+    printf("OCEAN GPU: gfx3d rcg %s root %s cmd %08x cfg %08x\n", rcg ? "updated" : "TIMEOUT",
+        root ? "on" : "OFF", rd(gcc, GFX3D_CMD), rd(gcc, GFX3D_CFG));
+    pause_s(3);
+
+    /* 4. GX GDSC, then the core branch (retain mem/periph), timer and AON. */
+    bool gx = gdsc_on(gcc, GX_GDSC);
+    wr(gcc, CBCR_GFX3D, rd(gcc, CBCR_GFX3D) | (1u << 14) | (1u << 13));
+    bool core = branch_on(gcc, CBCR_GFX3D);
+    bool timer = branch_on(gcc, CBCR_TIMER);
+    bool aon = branch_on(gcc, CBCR_AON);
+    printf("OCEAN GPU: gx_gdsc %s gfx3d %s timer %s aon %s\n", gx ? "on" : "TIMEOUT",
+        core ? "on" : "OFF", timer ? "on" : "OFF", aon ? "on" : "OFF");
+    dump(gcc, ldo, "after power-up:");
+    if (!(cx && ahb && bimc_gfx && root && gx && core && timer)) {
+        printf("OCEAN GPU: not all on, no GPU register access\n");
+        return;
+    }
+    pause_s(3);
+
+    /* 5. GPU registers. */
+    vm_offset_t gpu = ml_io_map(GPU_PA, 0x40000);
+    if (!gpu) {
+        printf("OCEAN GPU: GPU map failed\n");
+        return;
+    }
+    printf("OCEAN GPU: reading GPU registers\n");
+    uint32_t vbif = rd(gpu, 0x3000 * 4);
+    uint32_t status = rd(gpu, 0x4f5 * 4);
+    uint32_t aon0 = rd(gpu, 0x4d2 * 4);
+    delay(1000);
+    uint32_t aon1 = rd(gpu, 0x4d2 * 4);
+    printf("OCEAN GPU: VBIF_VERSION %08x RBBM_STATUS %08x ALWAYSON %08x -> %08x (%s)\n",
+        vbif, status, aon0, aon1, aon1 != aon0 ? "counting: GPU alive" : "not counting");
+}
+
+void ocean_gpu_start(void) {
+    int enabled = 0;
+    thread_t thread;
+    PE_parse_boot_argn("ocean_gpu", &enabled, sizeof(enabled));
+    if (enabled != 1) { return; }
+    printf("OCEAN GPU: Adreno 506 power probe in 20 s\n");
+    if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    }
+}
+#endif
