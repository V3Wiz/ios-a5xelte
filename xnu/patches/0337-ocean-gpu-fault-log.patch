+/* What the GPU and its SMMU flagged since the last look; the service calls
+ * it after each submission and CPU wait. Faulting transactions terminate
+ * without a stall (CB0 SCTLR), so a dropped write shows only here. The
+ * first three looks are logged whatever they find, then the first 24 that
+ * find a fault; the SMMU fault and the RBBM interrupts are cleared. */
+void ocean_gpu_check(const char *when);
+void ocean_gpu_check(const char *when) {
+    static unsigned looks, faults;
+    vm_offset_t cb = keep.smmu + SMMU_CB0;
+    uint32_t fsr = rd(cb, CB_FSR), irq = gr(keep.gpu, R_RBBM_INT_0_STATUS);
+    uint32_t hw = gr(keep.gpu, R_CP_HW_FAULT), prot = gr(keep.gpu, R_CP_PROTECT_STATUS);
+    uint32_t ahb = gr(keep.gpu, R_RBBM_AHB_ERROR_STATUS);
+    bool fault = fsr || hw || prot || ahb;
+    if (looks++ < 3 || (fault && faults++ < 24)) {
+        printf("OCEAN GPU: check %s: INT_0 %08x HW_FAULT %08x PROTECT %08x AHB_ERR %08x RBBM_STATUS %08x "
+            "SMMU FSR %08x FAR %08x%08x FSYNR0 %08x fence %u done %u RPTR %u WPTR %u\n", when, irq, hw, prot,
+            ahb, gr(keep.gpu, R_RBBM_STATUS), fsr, rd(cb, CB_FAR + 4), rd(cb, CB_FAR), rd(cb, CB_FSYNR0),
+            keep.fence, fence_done(), gr(keep.gpu, R_CP_RB_RPTR), keep.ring_at);
+    }
+    if (fsr) { wr(cb, CB_FSR, fsr); }
+    if (irq) { gw(keep.gpu, R_RBBM_INT_CLEAR_CMD, irq); }
+}
