+/*
+ * test36: the SAW had never been used (PMIC_STS 0, VCTL 0): the bootloader
+ * sets pm8953_s5 straight through the PMIC arbiter and leaves the SAW
+ * alone. spm-regulator.c falls back to the same thing when the SPM path
+ * fails (qpnp_smps_write_voltage): VSET (0x41) of the S5 peripheral (sid 1,
+ * 0x2000) over SPMI. PMIC arbiter v2 from the FDT (spmi@200f000: chnls
+ * 0x2400000, obsrvr 0x2c00000, cnfg 0x200a000, qcom,ee 0); written only
+ * when the ownership table gives the channel to this EE.
+ */
+#define SPMI_CORE_PA    0x0200f000u
+#define SPMI_CHNLS_PA   0x02400000u
+#define SPMI_OBS_PA     0x02c00000u
+#define SPMI_CNFG_PA    0x0200a000u
+#define S5_PPID         0x120u          /* sid 1, peripheral 0x20 */
+#define S5_RANGE        0x40u
+#define S5_VSET         0x41u
+
+static vm_offset_t s5_rd, s5_wr;
+
+static int spmi_cmd(vm_offset_t ch, uint32_t cmd) {
+    wr(ch, 0x0, cmd);
+    for (unsigned i = 0; i < 10000; i++) {
+        uint32_t status = rd(ch, 0x8);
+        if (status & 1u) { return (status & 0xeu) ? EIO : 0; }
+        delay(1);
+    }
+    return ETIMEDOUT;
+}
+
+static int s5_read(uint8_t off, uint8_t *v) {
+    int e = spmi_cmd(s5_rd, (1u << 27) | ((uint32_t)off << 4));         /* EXT_READL, 1 byte */
+    if (!e) { *v = (uint8_t)rd(s5_rd, 0x18); }
+    return e;
+}
+
+static int s5_write(uint8_t off, uint8_t v) {
+    wr(s5_wr, 0x10, v);
+    return spmi_cmd(s5_wr, (0u << 27) | ((uint32_t)off << 4));          /* EXT_WRITEL, 1 byte */
+}
+
+/* The S5 channel, if this EE owns it; logs what it finds. */
+static bool s5_open(void) {
+    vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x1000), cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+    if (!core || !cnfg) { return false; }
+    for (unsigned ch = 0; ch < 512; ch++) {
+        if (((rd(core, 0x800 + 4 * ch) >> 8) & 0xfffu) == S5_PPID) {
+            uint32_t owner = rd(cnfg, 0x700 + 4 * ch) & 7u;
+            s5_rd = ml_io_map(SPMI_OBS_PA + 0x8000 * ch, 0x1000);
+            s5_wr = ml_io_map(SPMI_CHNLS_PA + 0x8000 * ch, 0x1000);
+            printf("OCEAN CPU: S5 SPMI channel %u, owner EE %u\n", ch, owner);
+            return owner == 0 && s5_rd && s5_wr;
+        }
+    }
+    printf("OCEAN CPU: S5 SPMI channel not found\n");
+    return false;
+}
+
+static bool s5_set(uint32_t vlevel) {
+    uint8_t got = 0;
+    if (s5_write(S5_VSET, (uint8_t)vlevel)) { return false; }
+    delay(5000);                        /* slew (~600 uV/us at this STEP_CTRL) + settling */
+    return !s5_read(S5_VSET, &got) && got == vlevel;
+}
+
+static bool rail_set(vm_offset_t saw, bool direct, uint32_t vlevel) {
+    return direct ? s5_set(vlevel) : saw_set_vdd(saw, vlevel);
+}
+
+static uint32_t rail_level(vm_offset_t saw, bool direct) {
+    uint8_t v = 0;
+    if (direct) { return s5_read(S5_VSET, &v) ? 0 : v; }
+    return saw_level(saw) & 0xffu;
+}
