+/* Zap shader (FDT qcom,kgsl-hyp: pil-tz-generic, pas-id 13, firmware
+ * a506_zap, memory-region gpu_region = CMA in 0x80000000..0x90000000).
+ * 0x8fc00000 is System RAM there, outside the XNU window and below the
+ * splash framebuffer at 0x90001000. */
+#define ZAP_PA                  0x8fc00000u
+#define ZAP_SIZE                0x00100000u
+#define GPU_PAS_ID              13
+/* Crypto engine for TZ's signature check (FDT scm_core/iface/bus clocks):
+ * APCS_CLOCK_BRANCH_ENA_VOTE bits 0..2, crypto RCG 0x16004 at 80 MHz. */
+#define APCS_VOTE               0x45004u
+#define CRYPTO_CMD              0x16004u
+#define CRYPTO_CFG              0x16008u
 
