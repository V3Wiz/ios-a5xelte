+        if (ticks() - start >= 19200000ULL * 2) {
+            printf("OCEAN SDHCI: programming timeout lba=%llu\n", lba);
+            return ETIMEDOUT;
+        }
+        __asm__ volatile("yield");
+    }
+    return error;
