+#if defined(ARM64_BOARD_CONFIG_OCEAN)
+void
+AppleCLCD::oceanScanout(void)
+{
+	if (!fPanelCleared) {
+		/* Drop the boot console text once; the margins stay black. */
+		for (uint32_t y = 0; y < A5XELTE_FB_HEIGHT; y++) {
+			bzero((void *)(fPanel + (uint64_t)y * A5XELTE_FB_STRIDE), A5XELTE_FB_WIDTH * 3);
+		}
+		fPanelCleared = true;
+	}
+	for (uint32_t y = 0; y < A5XELTE_FB_HEIGHT; y++) {
+		uint32_t sy = (uint32_t)(((uint64_t)y * fHeight + fHeight / 2) / A5XELTE_FB_HEIGHT);
+		const uint32_t *src = (const uint32_t *)(fPixels + (uint64_t)sy * fRowBytes);
+		volatile uint32_t *dst = (volatile uint32_t *)(fPanel + (uint64_t)y * A5XELTE_FB_STRIDE +
+		    OCEAN_SCAN_X * 3);
+		/* BGRA little-endian words -> packed B,G,R bytes, 4 pixels per 3 words. */
+		for (uint32_t x = 0; x < OCEAN_SCAN_W; x += 4) {
+			uint32_t p0 = src[fScanSrcX[x]], p1 = src[fScanSrcX[x + 1]];
+			uint32_t p2 = src[fScanSrcX[x + 2]], p3 = src[fScanSrcX[x + 3]];
+			*dst++ = (p0 & 0xffffff) | (p1 << 24);
+			*dst++ = ((p1 >> 8) & 0xffff) | (p2 << 16);
+			*dst++ = ((p2 >> 16) & 0xff) | (p3 << 8);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+#endif
