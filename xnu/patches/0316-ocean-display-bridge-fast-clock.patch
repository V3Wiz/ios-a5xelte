+/* SDCC1 RCG update with the root force-enabled across the switch, as in
+ * the loader's verified XO400k sequence. */
+static int rcg_update(volatile uint32_t *gcc, uint32_t cfg) {
+    gcc[0x42004 / 4] |= 2;
+    __asm__ volatile("dsb sy" ::: "memory");
+    uint64_t start = ticks();
+    while (gcc[0x42004 / 4] & 0x80000000U) {
+        if (ticks() - start > 1920000ULL) { return ETIMEDOUT; }
+    }
+    gcc[0x42008 / 4] = cfg;
+    __asm__ volatile("dsb sy" ::: "memory");
+    gcc[0x42004 / 4] |= 1;
+    __asm__ volatile("dsb sy" ::: "memory");
+    start = ticks();
+    while (gcc[0x42004 / 4] & 0x80000001U) {
+        if (ticks() - start > 1920000ULL) { return ETIMEDOUT; }
+    }
+    return gcc[0x42008 / 4] == cfg ? 0 : EIO;
+}
+static int card_clock(volatile uint32_t *gcc, uint32_t cfg) {
+    w16(0x2c, r16(0x2c) & ~4U); /* Card clock off across the switch. */
+    __asm__ volatile("dsb sy" ::: "memory");
+    int error = rcg_update(gcc, cfg);
+    w16(0x2c, r16(0x2c) | 4U);
+    uint64_t start = ticks();
+    while ((r16(0x2c) & 7) != 7) {
+        if (ticks() - start > 1920000ULL) { return error ? error : ETIMEDOUT; }
+    }
+    delay_us(1000);
+    return error;
+}
+
+/* Boot-arg ocean_fastclk=1: after identification at 400 kHz, run data
+ * transfers from XO directly (19.2 MHz, default-speed timing, still one
+ * bit). The GPT header must read back identically, else revert. */
+static void fast_clock(void) {
+    int optin = 0;
+    PE_parse_boot_argn("ocean_fastclk", &optin, sizeof(optin));
+    if (optin != 1) { return; }
+    volatile uint32_t *gcc = (volatile uint32_t *)ml_io_map(0x01800000, 0x80000);
+    uint8_t before[512], after[512];
+    if (!gcc || read_sector(1, before)) { return; }
+    uint32_t slow = gcc[0x42008 / 4];
+    if ((slow & 0x371fU) != 0x2017U) {
+        printf("OCEAN CLOCK: unexpected cfg=%x, staying at 400k\n", slow);
+        return;
+    }
+    int error = card_clock(gcc, slow & ~0x371fU);
+    if (!error) { error = command(13, 1U << 16, NULL); }
+    if (!error) { error = read_sector(1, after); }
+    if (!error && memcmp(before, after, sizeof(before))) { error = EIO; }
+    if (error) {
+        printf("OCEAN CLOCK: XO 19.2 MHz failed (%d), reverting to 400k\n", error);
+        card_clock(gcc, slow);
+        return;
+    }
+    printf("OCEAN CLOCK: data transfers at XO 19.2 MHz cfg=%x\n", gcc[0x42008 / 4]);
+}
