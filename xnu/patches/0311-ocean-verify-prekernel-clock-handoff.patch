+/* Validate runtime translation, including actual stage-1 memory type. */
+static int audit_io(vm_offset_t va, uint64_t expected) {
+    uint64_t par, saved;
+    __asm__ volatile("mrs %1, daif; msr daifset, #15; at s1e1r, %2; isb; "
+        "mrs %0, par_el1; msr daif, %1"
+        : "=&r"(par), "=&r"(saved) : "r"(va) : "memory");
+    printf("OCEAN MAP: expected=%llx PAR=%llx\n", expected, par);
+    if ((par & 1) || (par & 0x0000fffffffff000ULL) != (expected & ~4095ULL) ||
+        ((va ^ expected) & 4095) || (par >> 56) > 0x0c) {
+        printf("OCEAN MAP: wrong physical translation or non-device memory\n");
+        return EFAULT;
+    }
+    return 0;
+}
