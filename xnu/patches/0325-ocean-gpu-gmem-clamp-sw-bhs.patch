+/*
+ * Fallback, msm_gfx_ldo switch_mode_to_bhs: power the BHS up under SW
+ * control (fake ack to the GDSC meanwhile), wait for BHS_EN_REST_ACK, then
+ * expose it to the GDSC again. Returns the PWRSWITCH status seen.
+ */
+static uint32_t gfx_ldo_sw_bhs(vm_offset_t ldo) {
+    uint32_t ctl = rd(ldo, LDO_PWRSWITCH), status = 0;
+    ctl |= 1u << 8;                     /* ACK_SW_OVR: fake ack to the GDSC */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 9);                  /* power source: BHS */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 5);                  /* LDO stays on */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl |= 1u << 4;                     /* LDO under SW control */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl |= 1u << 0;                     /* BHS under SW control */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl |= 1u << 1;                     /* BHS_EN_FEW */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl |= 1u << 2;                     /* BHS_EN_REST */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    for (unsigned i = 0; i < 500; i++) {
+        status = rd(ldo, LDO_PWR_STATUS);
+        if (status & 2u) { break; }     /* BHS_EN_REST_ACK */
+        delay(10);
+    }
+    ctl |= 1u << 6;                     /* bypass the LDO */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl |= 1u << 5;                     /* pull the LDO down */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 8);                  /* expose the BHS to the GDSC */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~1u;
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 30);                 /* CPR on in BHS mode */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    return status;
+}
+
