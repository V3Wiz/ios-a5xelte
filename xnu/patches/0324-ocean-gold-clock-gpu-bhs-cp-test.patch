     thread_t thread;
-    PE_parse_boot_argn("ocean_gpu", &enabled, sizeof(enabled));
-    if (enabled != 1) { return; }
-    printf("OCEAN GPU: Adreno 506 power probe in 20 s\n");
-    if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+    PE_parse_boot_argn("ocean_gpu", &stages, sizeof(stages));
+    if (stages < 1) { return; }
+    printf("OCEAN GPU: Adreno 506 bring-up (stages %d) in 20 s\n", stages);
+    if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)stages, &thread) == KERN_SUCCESS) {
         thread_deallocate(thread);
     }
 }
