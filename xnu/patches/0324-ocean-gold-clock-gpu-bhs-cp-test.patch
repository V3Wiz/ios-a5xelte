+/*
+ * test29 found the Gold cluster (perfcl, MPIDR 0x100..) muxed to source 0,
+ * the 19.2 MHz XO, while the boot cluster runs from source 4 / 1 = GPLL0
+ * (about 800 MHz measured). Move the Gold mux (apcs-c1-rcg-base 0xb011050:
+ * CMD, CFG at +4) to the same GPLL0 setting; 800 MHz is within the Gold
+ * corner the current 870 mV rail already supports. ocean_goldclk=0 skips it.
+ */
+void ocean_cpu_clocks(void);
+void ocean_cpu_clocks(void) {
+    int enabled = 1;
+    PE_parse_boot_argn("ocean_goldclk", &enabled, sizeof(enabled));
+    vm_offset_t apcs = enabled ? ml_io_map(0x0b011000, 0x1000) : 0;
+    if (!apcs) { return; }
+    uint32_t cmd = rd(apcs, 0x50), cfg = rd(apcs, 0x54);
+    if (cfg & 0x71fu) {
+        printf("OCEAN CPU: Gold mux already cfg %08x, left as is\n", cfg);
+        return;
+    }
+    wr(apcs, 0x54, (cfg & ~0x71fu) | (4u << 8) | 1u);
+    wr(apcs, 0x50, cmd | 1u);
+    bool ok = poll(apcs, 0x50, 1u, 0, 10);
+    printf("OCEAN CPU: Gold mux %s cmd %08x cfg %08x (was %08x)\n",
+        ok ? "-> GPLL0, about 800 MHz" : "update TIMEOUT", rd(apcs, 0x50), rd(apcs, 0x54), cfg);
 }
 
 void ocean_gpu_start(void) {
-    int enabled = 0;
