-static void gpu_thread(__unused void *arg, __unused wait_result_t wr_result) {
+        rd(gcc, CBCR_TIMER), rd(gcc, CBCR_AON), rd(ldo, LDO_PWRSWITCH), rd(ldo, LDO_PWR_STATUS),
+        rd(ldo, LDO_CFG0));
+}
+
+/* msm_gfx_ldo_init + enable_bhs_mode for MSM8953 (ops_type CORNER). */
+static void gfx_ldo_bhs(vm_offset_t ldo) {
+    uint32_t ctl = rd(ldo, LDO_PWRSWITCH);
+    ctl &= ~(1u << 31);                 /* LDO_CLAMP_IO */
+    ctl |= 1u << 29;                    /* EN_LDOAP_CTRL_CPR */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    wr(ldo, LDO_ATEST, 0x00000203);
+    wr(ldo, LDO_CFG0, 0x05008600);
+    wr(ldo, LDO_CFG1, 0x00000000);
+    wr(ldo, LDO_CFG2, 0x0000c3fc);
+    wr(ldo, LDO_VREF_TEST, 0x004b1102);
+    ctl |= 1u << 4;                     /* LDO under SW control */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 9);                  /* power source: BHS */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 30);                 /* GFX CPR not bypassed */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 1);                  /* BHS control signals to the GDSC */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~(1u << 2);
+    wr(ldo, LDO_PWRSWITCH, ctl);
+    ctl &= ~1u;                         /* BHS under GDSC control */
+    wr(ldo, LDO_PWRSWITCH, ctl);
+}
+
+static uint32_t parity(uint32_t v) {
+    return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+        (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+/* msm_ringbuffer OUT_PKT7 header */
+static uint32_t pkt7(uint32_t op, uint32_t cnt) {
+    return (7u << 28) | cnt | (parity(cnt) << 15) | ((op & 0x7fu) << 16) | (parity(op) << 23);
+}
+
+static void gw(vm_offset_t gpu, uint32_t reg, uint32_t v) { wr(gpu, reg * 4, v); }
+static uint32_t gr(vm_offset_t gpu, uint32_t reg) { return rd(gpu, reg * 4); }
+static void gw64(vm_offset_t gpu, uint32_t reg, uint64_t v) {
+    gw(gpu, reg, (uint32_t)v);
+    gw(gpu, reg + 1, (uint32_t)(v >> 32));
+}
+
+/* Physically contiguous, zeroed kernel memory for the GPU; returns its PA. */
+static uint64_t gpu_alloc(vm_size_t size, vm_offset_t *va) {
+    size = round_page(size);
+    if (kmem_alloc_contig(kernel_map, va, size, PAGE_MASK, 0, 0,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+        return 0;
+    }
+    return ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)*va));
+}
+
+/* Microcode from the ADT, copied into GPU-visible contiguous memory. */
+static uint64_t ucode(const char *name, uint32_t *len) {
+    DTEntry node;
+    void const *data;
+    unsigned int size;
+    if (SecureDTLookupEntry(NULL, "/ocean-gpu", &node) != kSuccess ||
+        SecureDTGetProperty(node, name, &data, &size) != kSuccess || size < 64) {
+        return 0;
+    }
+    vm_offset_t va;
+    uint64_t pa = gpu_alloc(size, &va);
+    if (!pa) { return 0; }
+    memcpy((void *)va, data, size);
+    flush_dcache64((addr64_t)pa, size, TRUE);
+    *len = size;
+    return pa;
+}
+
+static void cp_state(vm_offset_t gpu, const char *when) {
+    printf("OCEAN GPU: %s RBBM_STATUS %08x RPTR %u WPTR %u CP_HW_FAULT %08x CP_INT %08x "
+        "RBBM_INT %08x TRUST %08x\n",
+        when, gr(gpu, R_RBBM_STATUS), gr(gpu, R_CP_RB_RPTR), gr(gpu, R_CP_RB_WPTR),
+        gr(gpu, R_CP_HW_FAULT), gr(gpu, R_CP_INTERRUPT_STATUS), gr(gpu, R_RBBM_INT_0_STATUS),
+        gr(gpu, R_SECVID_TRUST_CNTL));
+}
+
+/* Stage 2: command processor. */
+static void cp_test(vm_offset_t gpu) {
+    uint32_t pm4_len = 0, pfp_len = 0;
+    uint64_t pm4 = ucode("pm4", &pm4_len), pfp = ucode("pfp", &pfp_len);
+    if (!pm4 || !pfp) {
+        printf("OCEAN GPU: no /ocean-gpu pm4/pfp microcode in the ADT, no CP test\n");
+        return;
+    }
+    vm_offset_t smmu = ml_io_map(SMMU_PA, 0x10000);
+    if (!smmu) { return; }
+    uint32_t cr0 = rd(smmu, 0);
+    printf("OCEAN GPU: SMMU sCR0 %08x IDR0 %08x IDR1 %08x SMR0 %08x S2CR0 %08x CB0 SCTLR %08x\n",
+        cr0, rd(smmu, 0x20), rd(smmu, 0x24), rd(smmu, 0x800), rd(smmu, 0xc00), rd(smmu, 0x8000));
+    if (!(cr0 & 1u)) {
+        /* Not in bypass: CLIENTPD = 1 so the GPU uses physical addresses. */
+        wr(smmu, 0, cr0 | 1u);
+        printf("OCEAN GPU: SMMU sCR0 -> %08x\n", rd(smmu, 0));
+    }
+    vm_offset_t ring_va, scratch_va;
+    uint64_t ring = gpu_alloc(16384, &ring_va), scratch = gpu_alloc(PAGE_SIZE, &scratch_va);
+    if (!ring || !scratch) {
+        printf("OCEAN GPU: no ring/scratch memory\n");
+        return;
+    }
+    printf("OCEAN GPU: pm4 %llx (%u) pfp %llx (%u) ring %llx scratch %llx\n",
+        pm4, pm4_len, pfp, pfp_len, ring, scratch);
+    pause_s(3);
+
+    /* Subset of mainline a5xx_hw_init, A506 values. */
+    gw(gpu, R_VBIF_RR_QOS_ARB, 3);
+    gw(gpu, R_RBBM_AHB_CNTL0, 1);
+    gw(gpu, R_CP_MEQ_THRESHOLDS, 0x20);
+    gw(gpu, R_CP_MERCIU_SIZE, 0x400);
+    gw(gpu, R_CP_ROQ_THRESHOLDS_2, 0x40000030);
+    gw(gpu, R_CP_ROQ_THRESHOLDS_1, 0x20100d0a);
+    gw(gpu, R_CP_CHICKEN_DBG, 0x02000000);
+    gw(gpu, R_RBBM_AHB_CNTL1, 0xa6ffffff);
+    gw(gpu, R_RBBM_AHB_CNTL2, 0x3f);
+    gw(gpu, R_SECVID_TSB_CNTL, 0);
+    gw64(gpu, R_SECVID_TSB_BASE, 0);
+    gw(gpu, R_SECVID_TSB_SIZE, 0);
+    gw(gpu, R_CP_ADDR_MODE_CNTL, 1);
+    gw(gpu, R_SECVID_TSB_ADDR_MODE, 1);
+    gw64(gpu, R_CP_ME_INSTR_BASE, pm4);
+    gw64(gpu, R_CP_PFP_INSTR_BASE, pfp);
+    gw64(gpu, R_CP_RB_BASE, ring);
+    /* BUFSZ log2(16 KB / 8) = 11, BLKSZ log2(32 / 8) = 2 (mainline), NO_UPDATE */
+    gw(gpu, R_CP_RB_CNTL, 11u | (2u << 8) | (1u << 27));
+    cp_state(gpu, "before ME start:");
+
+    uint32_t *rb = (uint32_t *)ring_va, n = 0;
+    rb[n++] = pkt7(CP_ME_INIT, 8);
+    rb[n++] = 0x2f;
+    rb[n++] = 0x3;
+    rb[n++] = 0x20000000;
+    rb[n++] = 0;
+    rb[n++] = 0;
+    rb[n++] = 0xb;          /* A506/A530 token-end-sync workaround */
+    rb[n++] = 0;
+    rb[n++] = 0;
+    rb[n++] = pkt7(CP_MEM_WRITE, 3);
+    rb[n++] = (uint32_t)scratch;
+    rb[n++] = (uint32_t)(scratch >> 32);
+    rb[n++] = 0xc0ffee01;
+    rb[n++] = pkt7(CP_NOP, 0);
+    flush_dcache64((addr64_t)ring, 16384, TRUE);
+    flush_dcache64((addr64_t)scratch, PAGE_SIZE, TRUE);
+
+    gw(gpu, R_CP_PFP_ME_CNTL, 0);   /* clear ME_HALT */
+    gw(gpu, R_CP_RB_WPTR, n);
+    unsigned ms;
+    for (ms = 0; ms < 200 && gr(gpu, R_CP_RB_RPTR) != n; ms++) {
+        delay(1000);
+    }
+    delay(1000);
+    flush_dcache64((addr64_t)scratch, 64, TRUE);
+    uint32_t got = *(volatile uint32_t *)scratch_va;
+    cp_state(gpu, ms < 200 ? "ring consumed: COMMAND PROCESSOR RUNS" : "ring NOT consumed (200 ms):");
+    printf("OCEAN GPU: scratch %08x -> %s\n", got,
+        got == 0xc0ffee01 ? "CP_MEM_WRITE landed: GPU WRITES MEMORY" :
+        "no write (expected while in secure mode)");
+}
