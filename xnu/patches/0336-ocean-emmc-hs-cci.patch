+/*
+ * CCI PLL 0xb1d0000, a slewing alpha PLL (clock-cpu-sdm632.c apcs_cci_pll,
+ * clock-alpha-pll.c __init_alpha_pll + dyna_alpha_pll_enable): config ctl,
+ * early output, latch interface off; lock at the VCO midpoint 750 MHz (L 39
+ * + alpha 1/16, vco 2, alpha enable), slew to 787.2 MHz with a dynamic
+ * update (MODE bit 22), then the output. Left alone if already running.
+ */
+#define CCI_PLL_PA      0x0b1d0000u
+#define CCI_PLL_L       41u             /* 41 x 19.2 MHz = 787.2 MHz */
+
+static bool cci_pll_start(vm_offset_t pll) {
+    if (rd(pll, 0x00) & 0x7u) { return false; }
+    wr(pll, 0x18, 0x4001055b);
+    wr(pll, 0x10, (rd(pll, 0x10) & ~0xfu) | 0x8u);
+    wr(pll, 0x14, rd(pll, 0x14) & ~(1u << 11));
+    wr(pll, 0x04, 39);
+    wr(pll, 0x08, 0);                           /* alpha 0x10000000 << 8, low word */
+    wr(pll, 0x0c, 0x10);
+    wr(pll, 0x10, (rd(pll, 0x10) & ~(3u << 20)) | (2u << 20) | (1u << 24));
+    uint32_t mode = rd(pll, 0x00) | (1u << 1);  /* BYPASSNL */
+    wr(pll, 0x00, mode);
+    delay(5);
+    wr(pll, 0x00, mode | (1u << 2));            /* RESET_N */
+    if (!poll(pll, 0x00, 1u << 31, 1u << 31, 2)) { return false; }
+    wr(pll, 0x04, CCI_PLL_L);
+    wr(pll, 0x08, 0);
+    wr(pll, 0x0c, 0);
+    wr(pll, 0x00, rd(pll, 0x00) | (1u << 22));
+    if (!poll(pll, 0x00, 1u << 22, 0, 2)) { return false; }
+    delay(1);
+    if (!poll(pll, 0x00, 1u << 31, 1u << 31, 2)) { return false; }
+    wr(pll, 0x00, rd(pll, 0x00) | 1u);          /* OUTCTRL */
+    return true;
+}
+
 static uint64_t cntpct(void) {
     uint64_t n;
     __asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(n));
@@ -1414,6 +1450,23 @@
     cpu_mhz("after Silver:");
     pause_s(2);
     cpu_mhz("check:");
+    if (stages < 4) { return; }
+
+    /* 4. CCI (L2 coherency and the CPUs' path to DDR): the bootloader leaves
+     * its mux (0xb1d1050, in the mem-acc page) on GPLL0 / 2 = 400 MHz; Linux
+     * runs it from its own PLL at 787.2 MHz, the top corner of this rail. */
+    vm_offset_t cci = ml_io_map(CCI_PLL_PA, 0x1000);
+    if (!cci) { return; }
+    pause_s(2);
+    lock = cci_pll_start(cci);
+    printf("OCEAN CPU: cci pll %s mode %08x l %x user %08x\n", lock ? "locked" : "NOT STARTED",
+        rd(cci, 0), rd(cci, 4), rd(cci, 0x10));
+    if (!lock) { return; }
+    wr(acc, 0x54, (rd(acc, 0x54) & ~0x71fu) | (5u << 8) | 1u);
+    wr(acc, 0x50, rd(acc, 0x50) | 1u);
+    m = poll(acc, 0x50, 1u, 0, 10);
+    printf("OCEAN CPU: CCI mux %s cmd %08x cfg %08x -> 787.2 MHz\n", m ? "switched" : "update TIMEOUT",
+        rd(acc, 0x50), rd(acc, 0x54));
 }
 
