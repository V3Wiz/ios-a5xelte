+static int same_sectors(const uint8_t *want) {
+    static uint8_t got[4 * 512];
+    for (unsigned int i = 0; i < 4; i++) {
+        int error = read_sector(i, got + i * 512);
+        if (error) { return error; }
+    }
+    return memcmp(want, got, sizeof(got)) ? EIO : 0;
+}
+
+/* Boot-arg ocean_hs=1 (after ocean_fastclk=1 and ocean_4bit=1): eMMC
+ * high-speed timing (EXT_CSD[185] HS_TIMING = 1, host High Speed Enable)
+ * at 50 MHz, the msm8953 GCC table's GPLL0 / 16 entry (RCG source 1, divider
+ * field 31; GPLL0 must be locked and voted), then the 8-bit bus (EXT_CSD[183]
+ * = 2, host 8-bit width). Below 100 MHz sdhci-msm needs no tuning or DLL.
+ * Sectors 0..3 must read back identically after each step, else it is
+ * undone: 8-bit falls back to 4-bit, the clock to XO 19.2 MHz. */
+static void high_speed(void) {
+    int optin = 0;
+    PE_parse_boot_argn("ocean_hs", &optin, sizeof(optin));
+    if (optin != 1) { return; }
+    volatile uint32_t *gcc = (volatile uint32_t *)ml_io_map(0x01800000, 0x80000);
+    static uint8_t want[4 * 512];
+    if (!gcc || (r8(0x28) & 0x22) != 0x02) { return; }
+    for (unsigned int i = 0; i < 4; i++) {
+        if (read_sector(i, want + i * 512)) { return; }
+    }
+    uint32_t xo = gcc[0x42008 / 4];
+    if ((xo & 0x371fU) || !(gcc[0x21000 / 4] & 0x80000000U) || !(gcc[0x45000 / 4] & 1U)) {
+        printf("OCEAN CLOCK: cfg=%x gpll0 mode=%x vote=%x, staying at 19.2 MHz\n",
+            xo, gcc[0x21000 / 4], gcc[0x45000 / 4]);
+        return;
+    }
+    int error = command(6, 0x03b90100U, NULL);
+    if (!error) { error = wait_transfer_state(); }
+    if (!error && (ocean_last_r1 & 0x80)) { error = EIO; } /* SWITCH_ERROR */
+    if (!error) {
+        w8(0x28, r8(0x28) | 0x04); /* Host high-speed enable. */
+        error = card_clock(gcc, (xo & ~0x71fU) | 0x11fU);
+    }
+    if (!error) { error = wait_transfer_state(); }
+    if (!error) { error = same_sectors(want); }
+    if (error) {
+        printf("OCEAN CLOCK: 50 MHz high speed failed (%d) R1=0x%x, back to 19.2 MHz\n",
+            error, ocean_last_r1);
+        card_clock(gcc, xo);
+        w8(0x28, r8(0x28) & ~0x04);
+        recover();
+        command(6, 0x03b90000U, NULL);
+        wait_transfer_state();
+        return;
+    }
+    printf("OCEAN CLOCK: data transfers at 50 MHz high speed cfg=%x\n", gcc[0x42008 / 4]);
+    error = command(6, 0x03b70200U, NULL);
+    if (!error) { error = wait_transfer_state(); }
+    if (!error && (ocean_last_r1 & 0x80)) { error = EIO; }
+    if (!error) {
+        w8(0x28, (r8(0x28) & ~0x02) | 0x20); /* Host 8-bit data width. */
+        error = same_sectors(want);
+    }
+    if (error) {
+        printf("OCEAN SDHCI: 8-bit bus failed (%d) R1=0x%x, back to 4-bit\n", error, ocean_last_r1);
+        w8(0x28, (r8(0x28) & ~0x20) | 0x02);
+        recover();
+        command(6, 0x03b70100U, NULL);
+        wait_transfer_state();
+        return;
+    }
+    printf("OCEAN SDHCI: 8-bit data bus\n");
+}
