diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -349,17 +349,17 @@
 
 	sweet_early_mark(1, "arm_init entered (MMU on)");
 #if defined(OCEAN)
-    /* Deliberate stop BEFORE relocation/signing, boot-argument dereference,
-     * CPU data, device tree, timers, interrupts or inherited platform MMIO. */
-    sweet_early_mark(2, "C ENTRY REACHED - TEST STOP");
-    for (;;) {
-        __asm__ volatile("wfe" ::: "memory");
-    }
+    sweet_early_mark(1, "platform batch continuing");
 #endif
 
 	arm_setup_pre_sign();
-
+#if defined(OCEAN)
+    sweet_early_mark(1, "pre-sign done; rebasing image");
+#endif
 	arm_slide_rebase_and_sign_image();
+#if defined(OCEAN)
+    sweet_early_mark(1, "rebase done; reading boot args");
+#endif
 
 	/* If kernel integrity is supported, use a constant copy of the boot args. */
 	const_boot_args = *args;
@@ -379,6 +379,9 @@
 	BootCpuData.jop_key = ml_default_jop_pid();
 #endif /* defined(HAS_APPLE_PAC) */
 
+#if defined(OCEAN)
+    sweet_early_mark(2, "boot args and CPU data ready");
+#endif
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
 	sweet_early_mark(2, "PE_init_platform done");
 
@@ -441,6 +444,20 @@
 	}
 #endif
 
+#if defined(OCEAN)
+    uint64_t ocean_cntfrq, ocean_counter_a, ocean_counter_b;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(ocean_cntfrq));
+    __asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(ocean_counter_a));
+    for (unsigned int i = 0; i < 4096; i++) {
+        __asm__ volatile("nop");
+    }
+    __asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(ocean_counter_b));
+    if (ocean_cntfrq != 19200000 || ocean_counter_b <= ocean_counter_a ||
+        gPEClockFrequencyInfo.timebase_frequency_hz != ocean_cntfrq) {
+        panic("OCEAN: physical counter or ADT timebase mismatch");
+    }
+    sweet_early_mark(3, "19.2 MHz counter OK; topology next");
+#endif
 	ml_parse_cpu_topology();
 	sweet_early_mark(3, "ml_parse_cpu_topology done");
 
@@ -460,6 +477,9 @@
 	    + ((uintptr_t)&BootCpuData
 	    - (uintptr_t)(args->virtBase)));
 
+#if defined(OCEAN)
+    sweet_early_mark(4, "topology ready; first kernel thread");
+#endif
 	thread = thread_bootstrap();
 	thread->machine.CpuDatap = &BootCpuData;
 	thread->machine.pcpu_data_base = (vm_offset_t)0;
@@ -476,7 +496,9 @@
 	sweet_early_mark(4, "cpu_bootstrap done");
 
 	rtclock_early_init();
-
+#if defined(OCEAN)
+    sweet_early_mark(4, "thread and clock ready; kernel init");
+#endif
 	kernel_debug_string_early("kernel_startup_bootstrap");
 	kernel_startup_bootstrap();
 	sweet_early_mark(5, "kernel_startup_bootstrap done");
@@ -536,6 +558,15 @@
 	__builtin_arm_wsr("pan", 1);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
+#if defined(OCEAN)
+    /* This batch covers the full pre-VM path in one run. The next mapping
+     * transition requires a persistent 24-bit console and exception path;
+     * do not enter inherited final-VM/device code until those are ported. */
+    sweet_early_mark(7, "PRE-VM BATCH COMPLETE");
+    for (;;) {
+        __asm__ volatile("wfe" ::: "memory");
+    }
+#endif
 	sweet_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
 	sweet_early_mark(15, "arm_vm_init returned");
