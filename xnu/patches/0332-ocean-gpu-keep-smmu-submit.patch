diff --git a/bsd/dev/ocean_gpu.c b/bsd/dev/ocean_gpu.c
--- a/bsd/dev/ocean_gpu.c
+++ b/bsd/dev/ocean_gpu.c
@@ -498,6 +498,486 @@
         got2 == 0xc0ffee02 ? "GPU OUT OF SECURE MODE AND WRITING" : "no write");
 }
 
+/*
+ * Stage 4 (ocean_gpu=4): the GPU kept on for programs to draw with, the way
+ * Linux's msm driver keeps it, as the backend of an msm-DRM style service
+ * (after HakiOS's hakios.adreno.c "the GPU kept on", APSL 2.0). Sources:
+ *   - mainline a5xx_gpu.c a5xx_hw_init / a5xx_submit, A506 entry of
+ *     adreno_device.c (GMEM 128K + 8K, TWO_PASS_USE_WFI, LMLOADKILL_DISABLE);
+ *   - Qualcomm arm-smmu.c arm_smmu_init_context_bank and msm_tz_smmu.c
+ *     msm_tz_set_cb_format (SMC svc 0x15 cmd 1: sec_id, cb, 1), the call
+ *     traced from TWRP's kgsl right after the GPU powers up.
+ * The 3D core's context bank 0 (SMR0 -> S2CR0 -> CB0, set up by TZ) gets
+ * AArch64 stage-1 tables for a 32-bit GPU address space: the ring, scratch
+ * page and microcode at their physical addresses, buffers from GPU_VA_START.
+ * No interrupts yet: fences are polled from the scratch page.
+ */
+#define SMMU_GR1                0x1000u
+#define SMMU_CB0                0x8000u         /* IDR1: 4K pages, NUMPAGE 8 */
+#define CB_SCTLR                0x000u
+#define CB_ACTLR                0x004u
+#define CB_TCR2                 0x010u
+#define CB_TTBR0                0x020u
+#define CB_TCR                  0x030u
+#define CB_MAIR0                0x038u
+#define CB_MAIR1                0x03cu
+#define CB_FSR                  0x058u
+#define CB_FAR                  0x060u
+#define CB_FSYNR0               0x068u
+#define CB_TLBIALL              0x618u
+#define CB_TLBSYNC              0x7f0u
+#define CB_TLBSTATUS            0x7f4u
+#define GPU_VA_START            0x60000000ull   /* above the XNU RAM window (identity part) */
+#define GPU_VA_END              0xf0000000ull
+#define GPU_RING_BYTES          32768u
+#define GPU_RING_WORDS          (GPU_RING_BYTES / 4)
+#define GPU_FENCE_AT            0x40u           /* in the scratch page */
+#define GPU_GMEM_BYTES          (0x20000u + 0x2000u)
+#define CP_INDIRECT_BUFFER_PFE  0x3f
+#define CP_EVENT_WRITE          0x46
+#define CACHE_FLUSH_TS          4
+
+#define R_RBBM_INTERFACE_HANG_INT_CNTL  0x002f
+#define R_RBBM_INT_0_MASK               0x0038
+#define R_RBBM_PERFCTR_CNTL             0x0464
+#define R_RBBM_PERFCTR_RBBM_SEL_0       0x046b
+#define R_RBBM_PERFCTR_GPU_BUSY_MASKED  0x046f
+#define R_CP_PROTECT(i)                 (0x0880 + (i))
+#define R_CP_PROTECT_CNTL               0x08a0
+#define R_CP_IB1_BASE                   0x0b1f
+#define R_CP_IB1_BUFSZ                  0x0b21
+#define R_CP_PERFCTR_CP_SEL_0           0x0bb0
+#define R_VSC_ADDR_MODE_CNTL            0x0bc1
+#define R_GRAS_ADDR_MODE_CNTL           0x0c81
+#define R_RB_DBG_ECO_CNTL               0x0cc4
+#define R_RB_ADDR_MODE_CNTL             0x0cc5
+#define R_RB_MODE_CNTL                  0x0cc6
+#define R_PC_DBG_ECO_CNTL               0x0d00
+#define R_PC_ADDR_MODE_CNTL             0x0d01
+#define R_HLSQ_DBG_ECO_CNTL             0x0e04
+#define R_HLSQ_ADDR_MODE_CNTL           0x0e05
+#define R_VFD_ADDR_MODE_CNTL            0x0e41
+#define R_VPC_DBG_ECO_CNTL              0x0e60
+#define R_VPC_ADDR_MODE_CNTL            0x0e61
+#define R_UCHE_ADDR_MODE_CNTL           0x0e80
+#define R_UCHE_MODE_CNTL                0x0e81
+#define R_UCHE_WRITE_THRU_BASE_LO       0x0e87
+#define R_UCHE_TRAP_BASE_LO             0x0e89
+#define R_UCHE_GMEM_RANGE_MIN_LO        0x0e8b
+#define R_UCHE_GMEM_RANGE_MAX_LO        0x0e8d
+#define R_UCHE_CACHE_WAYS               0x0e96
+#define R_SP_ADDR_MODE_CNTL             0x0ec1
+#define R_TPL1_ADDR_MODE_CNTL           0x0f01
+#define R_TPL1_MODE_CNTL                0x0f02
+
+/* mainline ADRENO_PROTECT_RW */
+static uint32_t protect_rw(uint32_t reg, uint32_t len) {
+    uint32_t log2 = 0;
+    while ((1u << (log2 + 1)) <= len) { log2++; }
+    return (1u << 30) | (1u << 29) | ((log2 & 0x1f) << 24) | ((reg << 2) & 0xfffff);
+}
+
+static struct {
+    bool kept;
+    vm_offset_t gpu, smmu;
+    vm_offset_t l1;                     /* level-1 table: 4 entries of 1 GB */
+    uint64_t l1_pa;
+    vm_offset_t l2[4];                  /* level-2 tables, 2 MB entries */
+    uint64_t l2_pa[4];
+    vm_offset_t l3[4 * 512];            /* level-3 tables, 4K pages */
+    uint64_t l3_pa[4 * 512];
+    vm_offset_t ring_va, scratch_va;
+    uint64_t ring, scratch;             /* physical = GPU address */
+    uint32_t ring_at;                   /* next word to write */
+    uint32_t fence;                     /* last submission */
+    struct { uint64_t start, size; } free[1024];
+    unsigned free_count;
+} keep;
+
+static void to_memory(uint64_t pa, uint64_t size) {
+    flush_dcache64((addr64_t)pa, (unsigned)size, TRUE);
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static bool smmu_sync(void) {
+    vm_offset_t cb = keep.smmu + SMMU_CB0;
+    wr(cb, CB_TLBSYNC, 0);
+    for (unsigned i = 0; i < 1000; i++) {
+        if (!(rd(cb, CB_TLBSTATUS) & 1u)) { return true; }
+        delay(1);
+    }
+    return false;
+}
+
+/* A table page: zeroed, physically contiguous, cleaned to memory (the
+ * SMMU's table walks do not snoop this CPU's caches). */
+static bool table_page(vm_offset_t *va, uint64_t *pa) {
+    *pa = gpu_alloc(PAGE_SIZE, va);
+    if (!*pa) { return false; }
+    to_memory(*pa, PAGE_SIZE);
+    return true;
+}
+
+/* Map (or with pa 0, unmap) one 4K page of the GPU address space. */
+static bool space_map(uint64_t va, uint64_t pa, bool read_only) {
+    if (va >= (1ull << 32)) { return false; }
+    unsigned i1 = (unsigned)(va >> 30), i2 = (unsigned)(va >> 21) & 511, i3 = (unsigned)(va >> 12) & 511;
+    if (!keep.l2[i1]) {
+        if (!pa) { return true; }
+        if (!table_page(&keep.l2[i1], &keep.l2_pa[i1])) { return false; }
+        ((volatile uint64_t *)keep.l1)[i1] = keep.l2_pa[i1] | 3u;
+        to_memory(keep.l1_pa + i1 * 8, 8);
+    }
+    unsigned t = i1 * 512 + i2;
+    if (!keep.l3[t]) {
+        if (!pa) { return true; }
+        if (!table_page(&keep.l3[t], &keep.l3_pa[t])) { return false; }
+        ((volatile uint64_t *)keep.l2[i1])[i2] = keep.l3_pa[t] | 3u;
+        to_memory(keep.l2_pa[i1] + i2 * 8, 8);
+    }
+    /* page, AttrIndx 0 (MAIR normal non-cacheable), AP unprivileged (and
+     * read-only), non-shareable, AF */
+    uint64_t pte = pa ? ((pa & 0xfffffff000ull) | 3u | (1u << 6) | (read_only ? (1u << 7) : 0) | (1u << 10)) : 0;
+    ((volatile uint64_t *)keep.l3[t])[i3] = pte;
+    to_memory(keep.l3_pa[t] + i3 * 8, 8);
+    return true;
+}
+
+static bool smmu_setup(void) {
+    uint64_t r1 = 0;
+    int64_t fmt = scm_call(0x15, 0x01, 3, 0x12, 0, 1, &r1);        /* msm_tz_set_cb_format */
+    printf("OCEAN GPU: SMMU CB0 format AArch64 -> %lld/%llx\n", fmt, r1);
+    if (!table_page(&keep.l1, &keep.l1_pa)) { return false; }
+    vm_offset_t cb = keep.smmu + SMMU_CB0;
+    wr(cb, CB_SCTLR, 0);
+    wr(keep.smmu + SMMU_GR1, 0x800, 1);                             /* CBA2R0: VA64 */
+    /* CBAR0: stage 1 with stage 2 bypass, NSH, write-back, VMID 1 */
+    wr(keep.smmu + SMMU_GR1, 0x000, (1u << 16) | (3u << 8) | (0xfu << 12) | 1u);
+    wr(cb, CB_TTBR0, (uint32_t)keep.l1_pa);
+    wr(cb, CB_TTBR0 + 4, (uint32_t)(keep.l1_pa >> 32));
+    /* T0SZ 32 (4 GB), walks non-cacheable / non-shareable, 4K granule,
+     * TTBR1 walks off; TCR2: 40-bit PA, sign extension upstream */
+    wr(cb, CB_TCR, 32u | (1u << 23));
+    wr(cb, CB_TCR2, 2u | (7u << 15));
+    wr(cb, CB_MAIR0, 0x0404ff44u);      /* 0 normal NC, 1 normal WB, 2/3 device */
+    wr(cb, CB_MAIR1, 0);
+    wr(cb, CB_ACTLR, (1u << 28) | (1u << 29) | (1u << 30));          /* QCOM OSH/ISH/NSH */
+    wr(cb, CB_FSR, 0xffffffffu);
+    /* M, TRE, AFE, CFRE, CFIE, ASIDPNE (faults terminate, no stall) */
+    wr(cb, CB_SCTLR, 1u | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 6) | (1u << 12));
+    wr(cb, CB_TLBIALL, 0);
+    bool synced = smmu_sync();
+    printf("OCEAN GPU: SMMU CB0 SCTLR %08x TCR %08x TTBR0 %08x%08x CBAR %08x %s\n", rd(cb, CB_SCTLR),
+        rd(cb, CB_TCR), rd(cb, CB_TTBR0 + 4), rd(cb, CB_TTBR0), rd(keep.smmu + SMMU_GR1, 0),
+        synced ? "synced" : "TLB SYNC TIMEOUT");
+    return synced;
+}
+
+static bool map_identity(uint64_t pa, uint64_t size) {
+    for (uint64_t off = 0; off < size; off += PAGE_SIZE) {
+        if (!space_map(pa + off, pa + off, false)) { return false; }
+    }
+    return true;
+}
+
+/* mainline a5xx_hw_init for A506, without HWCG and preemption. */
+static void hw_init(vm_offset_t gpu) {
+    gw(gpu, R_VBIF_RR_QOS_ARB, 3);
+    gw(gpu, R_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffffu);
+    gw(gpu, R_RBBM_AHB_CNTL0, 1);
+    gw(gpu, R_RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0xffffu);
+    gw(gpu, R_RBBM_PERFCTR_CNTL, 1);
+    gw(gpu, R_CP_PERFCTR_CP_SEL_0, 0);                  /* PERF_CP_ALWAYS_COUNT */
+    gw(gpu, R_RBBM_PERFCTR_RBBM_SEL_0, 6);
+    gw(gpu, R_UCHE_CACHE_WAYS, 2);
+    gw(gpu, R_UCHE_TRAP_BASE_LO, 0xffff0000u);
+    gw(gpu, R_UCHE_TRAP_BASE_LO + 1, 0x0001ffffu);
+    gw(gpu, R_UCHE_WRITE_THRU_BASE_LO, 0xffff0000u);
+    gw(gpu, R_UCHE_WRITE_THRU_BASE_LO + 1, 0x0001ffffu);
+    gw(gpu, R_UCHE_GMEM_RANGE_MIN_LO, 0x00100000u);
+    gw(gpu, R_UCHE_GMEM_RANGE_MIN_LO + 1, 0);
+    gw(gpu, R_UCHE_GMEM_RANGE_MAX_LO, 0x00100000u + GPU_GMEM_BYTES - 1);
+    gw(gpu, R_UCHE_GMEM_RANGE_MAX_LO + 1, 0);
+    gw(gpu, R_CP_MEQ_THRESHOLDS, 0x20);
+    gw(gpu, R_CP_MERCIU_SIZE, 0x400);
+    gw(gpu, R_CP_ROQ_THRESHOLDS_2, 0x40000030);
+    gw(gpu, R_CP_ROQ_THRESHOLDS_1, 0x20100d0a);
+    gw(gpu, R_PC_DBG_ECO_CNTL, (0x100u << 11) | (0x100u << 22) | (1u << 8));   /* + TWO_PASS_USE_WFI */
+    gw(gpu, R_RB_DBG_ECO_CNTL, gr(gpu, R_RB_DBG_ECO_CNTL) | (1u << 9));        /* 1-SP: no DP2 gating */
+    gw(gpu, R_UCHE_MODE_CNTL, 1u << 29);
+    gw(gpu, R_CP_CHICKEN_DBG, 0x02000000);
+    gw(gpu, R_RBBM_AHB_CNTL1, 0xa6ffffffu);
+    gw(gpu, R_RBBM_AHB_CNTL2, 0x3f);
+    gw(gpu, R_TPL1_MODE_CNTL, 1u << 7);                 /* highest bank bit: regbit 1 */
+    gw(gpu, R_RB_MODE_CNTL, 1u << 1);
+    gw(gpu, R_VPC_DBG_ECO_CNTL, gr(gpu, R_VPC_DBG_ECO_CNTL) | (1u << 10) | (1u << 23));  /* + LMLOADKILL */
+    gw(gpu, R_HLSQ_DBG_ECO_CNTL, gr(gpu, R_HLSQ_DBG_ECO_CNTL) & ~(1u << 18));
+    gw(gpu, R_CP_PROTECT_CNTL, 7);
+    static const uint32_t prot[][2] = {
+        { 0x04, 4 }, { 0x08, 8 }, { 0x10, 16 }, { 0x20, 32 }, { 0x40, 64 }, { 0x80, 64 },
+        { R_SECVID_TSB_BASE, 16 }, { R_SECVID_TRUST_CNTL, 2 }, { 0x800, 64 }, { 0x840, 8 },
+        { 0x880, 32 }, { 0xaa0, 1 }, { 0xcc0, 1 }, { 0xcf0, 2 }, { 0xe68, 8 }, { 0xe70, 16 },
+        { 0xe80, 16 }, { 0x10000, 0x8000 },
+    };
+    for (unsigned i = 0; i < sizeof(prot) / sizeof(prot[0]); i++) {
+        gw(gpu, R_CP_PROTECT(i), protect_rw(prot[i][0], prot[i][1]));
+    }
+    gw(gpu, R_SECVID_TSB_CNTL, 0);
+    gw64(gpu, R_SECVID_TSB_BASE, 0);
+    gw(gpu, R_SECVID_TSB_SIZE, 0);
+    static const uint32_t addr_mode[] = {
+        R_CP_ADDR_MODE_CNTL, R_VSC_ADDR_MODE_CNTL, R_GRAS_ADDR_MODE_CNTL, R_RB_ADDR_MODE_CNTL,
+        R_PC_ADDR_MODE_CNTL, R_HLSQ_ADDR_MODE_CNTL, R_VFD_ADDR_MODE_CNTL, R_VPC_ADDR_MODE_CNTL,
+        R_UCHE_ADDR_MODE_CNTL, R_SP_ADDR_MODE_CNTL, R_TPL1_ADDR_MODE_CNTL, R_SECVID_TSB_ADDR_MODE,
+    };
+    for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+        gw(gpu, addr_mode[i], 1);
+    }
+    gw(gpu, R_RBBM_INT_0_MASK, 0);                      /* polled, no interrupts yet */
+}
+
+static void ring_word(uint32_t v) {
+    ((volatile uint32_t *)keep.ring_va)[keep.ring_at] = v;
+    keep.ring_at = (keep.ring_at + 1) % GPU_RING_WORDS;
+}
+
+static void ring_send(void) {
+    to_memory(keep.ring, GPU_RING_BYTES);
+    gw(keep.gpu, R_CP_RB_WPTR, keep.ring_at);
+}
+
+static uint32_t fence_done(void) {
+    to_memory(keep.scratch + GPU_FENCE_AT, 64);
+    return *(volatile uint32_t *)(keep.scratch_va + GPU_FENCE_AT);
+}
+
+/* ---- backend for the GPU service (cf. hakios_gpu_*) ---- */
+bool ocean_gpu_ready(void);
+bool ocean_gpu_ready(void) { return keep.kept; }
+
+bool ocean_gpu_parameter(uint32_t which, uint64_t *value);
+bool ocean_gpu_parameter(uint32_t which, uint64_t *value) {
+    switch (which) {                    /* msm_drm.h MSM_PARAM_* */
+    case 0x01: *value = 506; return true;                       /* GPU_ID */
+    case 0x02: *value = GPU_GMEM_BYTES; return true;            /* GMEM_SIZE */
+    case 0x03: *value = 0x05000600; return true;                /* CHIP_ID */
+    case 0x04: *value = 133333333; return true;                 /* MAX_FREQ (current) */
+    case 0x05:                                                  /* TIMESTAMP: 19.2 MHz counter */
+        __asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(*value));
+        return true;
+    case 0x06: *value = 0x00100000; return true;                /* GMEM_BASE */
+    case 0x07: *value = 1; return true;                         /* PRIORITIES */
+    case 0x08: case 0x09: case 0x0a: *value = 0; return true;   /* PP_PGTABLE, FAULTS, SUSPENDS */
+    case 0x0b: *value = GPU_VA_START; return true;              /* VA_START */
+    case 0x0c: *value = GPU_VA_END - GPU_VA_START; return true; /* VA_SIZE */
+    default: return false;
+    }
+}
+
+uint64_t ocean_gpu_address(uint64_t size);
+uint64_t ocean_gpu_address(uint64_t size) {
+    size = (size + 0xffff) & ~0xffffull;
+    for (unsigned i = 0; i < keep.free_count; i++) {
+        if (keep.free[i].size >= size) {
+            uint64_t a = keep.free[i].start;
+            keep.free[i].start += size;
+            keep.free[i].size -= size;
+            if (keep.free[i].size == 0) {
+                memmove(&keep.free[i], &keep.free[i + 1], (--keep.free_count - i) * sizeof(keep.free[0]));
+            }
+            return a;
+        }
+    }
+    return 0;
+}
+
+void ocean_gpu_address_free(uint64_t address, uint64_t size);
+void ocean_gpu_address_free(uint64_t address, uint64_t size) {
+    unsigned at;
+    size = (size + 0xffff) & ~0xffffull;
+    for (at = 0; at < keep.free_count && keep.free[at].start < address; at++) {
+    }
+    if (at > 0 && keep.free[at - 1].start + keep.free[at - 1].size == address) {
+        keep.free[at - 1].size += size;
+        if (at < keep.free_count && address + size == keep.free[at].start) {
+            keep.free[at - 1].size += keep.free[at].size;
+            memmove(&keep.free[at], &keep.free[at + 1], (--keep.free_count - at) * sizeof(keep.free[0]));
+        }
+    } else if (at < keep.free_count && address + size == keep.free[at].start) {
+        keep.free[at].start = address;
+        keep.free[at].size += size;
+    } else if (keep.free_count < sizeof(keep.free) / sizeof(keep.free[0])) {
+        memmove(&keep.free[at + 1], &keep.free[at], (keep.free_count++ - at) * sizeof(keep.free[0]));
+        keep.free[at].start = address;
+        keep.free[at].size = size;
+    }
+}
+
+bool ocean_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+bool ocean_gpu_map(uint64_t address, uint64_t phys, bool read_only) {
+    return space_map(address, phys, read_only);
+}
+
+void ocean_gpu_mapped(void);
+void ocean_gpu_mapped(void) {
+    wr(keep.smmu + SMMU_CB0, CB_TLBIALL, 0);
+    smmu_sync();
+}
+
+void ocean_gpu_unmap(uint64_t address, uint64_t size);
+void ocean_gpu_unmap(uint64_t address, uint64_t size) {
+    for (uint64_t off = 0; off < size; off += PAGE_SIZE) {
+        space_map(address + off, 0, false);
+    }
+    ocean_gpu_mapped();
+}
+
+void ocean_gpu_to_memory(uint64_t phys, uint64_t size);
+void ocean_gpu_to_memory(uint64_t phys, uint64_t size) { to_memory(phys, size); }
+
+bool ocean_gpu_done(uint32_t fence);
+bool ocean_gpu_done(uint32_t fence) { return (int32_t)(fence_done() - fence) >= 0; }
+
+uint32_t ocean_gpu_last(void);
+uint32_t ocean_gpu_last(void) { return keep.fence; }
+
+/* Command buffers in order, as mainline a5xx_submit without preemption;
+ * returns the submission's fence, 0 when the ring stays full. */
+uint32_t ocean_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+uint32_t ocean_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count) {
+    uint32_t wanted = 8 + 4 * count, room = 0;
+    for (unsigned i = 0; i < 20000; i++) {
+        room = (gr(keep.gpu, R_CP_RB_RPTR) + GPU_RING_WORDS - keep.ring_at - 1) % GPU_RING_WORDS;
+        if (room >= wanted) { break; }
+        delay(100);
+    }
+    if (room < wanted) { return 0; }
+    if (++keep.fence == 0) { keep.fence = 1; }
+    for (uint32_t i = 0; i < count; i++) {
+        ring_word(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+        ring_word((uint32_t)addresses[i]);
+        ring_word((uint32_t)(addresses[i] >> 32));
+        ring_word(words[i]);
+    }
+    ring_word(pkt7(CP_EVENT_WRITE, 4));
+    ring_word(CACHE_FLUSH_TS);
+    ring_word((uint32_t)(keep.scratch + GPU_FENCE_AT));
+    ring_word((uint32_t)((keep.scratch + GPU_FENCE_AT) >> 32));
+    ring_word(keep.fence);
+    ring_send();
+    return keep.fence;
+}
+
+void ocean_gpu_report(const char *why);
+void ocean_gpu_report(const char *why) {
+    vm_offset_t cb = keep.smmu + SMMU_CB0;
+    printf("OCEAN GPU: %s: fence %u done %u RPTR %u WPTR %u RBBM_STATUS %08x CP_HW_FAULT %08x "
+        "CP_INT %08x IB1 %08x%08x/%u SMMU FSR %08x FAR %08x%08x FSYNR0 %08x\n", why, keep.fence,
+        fence_done(), gr(keep.gpu, R_CP_RB_RPTR), keep.ring_at, gr(keep.gpu, R_RBBM_STATUS),
+        gr(keep.gpu, R_CP_HW_FAULT), gr(keep.gpu, R_CP_INTERRUPT_STATUS),
+        gr(keep.gpu, R_CP_IB1_BASE + 1), gr(keep.gpu, R_CP_IB1_BASE), gr(keep.gpu, R_CP_IB1_BUFSZ),
+        rd(cb, CB_FSR), rd(cb, CB_FAR + 4), rd(cb, CB_FAR), rd(cb, CB_FSYNR0));
+}
+
+static bool wait_fence(uint32_t fence, unsigned ms) {
+    for (unsigned i = 0; i < ms * 10; i++) {
+        if (ocean_gpu_done(fence)) { return true; }
+        delay(100);
+    }
+    return false;
+}
+
+/* Two buffers at GPU addresses from the allocator: one holds a command
+ * buffer that makes the GPU write a word into the other. */
+static bool keep_selftest(void) {
+    vm_offset_t ib_va, dst_va;
+    uint64_t ib_pa = gpu_alloc(PAGE_SIZE, &ib_va), dst_pa = gpu_alloc(PAGE_SIZE, &dst_va);
+    uint64_t ib = ocean_gpu_address(PAGE_SIZE), dst = ocean_gpu_address(PAGE_SIZE);
+    if (!ib_pa || !dst_pa || !ib || !dst || !ocean_gpu_map(ib, ib_pa, true) ||
+        !ocean_gpu_map(dst, dst_pa, false)) {
+        printf("OCEAN GPU: self-test setup failed\n");
+        return false;
+    }
+    ocean_gpu_mapped();
+    uint32_t *cmd = (uint32_t *)ib_va, n = 0;
+    cmd[n++] = pkt7(CP_MEM_WRITE, 3);
+    cmd[n++] = (uint32_t)dst;
+    cmd[n++] = (uint32_t)(dst >> 32);
+    cmd[n++] = 0x5eed0506u;
+    cmd[n++] = pkt7(CP_NOP, 0);
+    to_memory(ib_pa, PAGE_SIZE);
+    to_memory(dst_pa, PAGE_SIZE);
+    uint32_t fence = ocean_gpu_submit(&ib, &n, 1);
+    bool done = fence && wait_fence(fence, 500);
+    to_memory(dst_pa, 64);
+    uint32_t got = *(volatile uint32_t *)dst_va;
+    printf("OCEAN GPU: self-test: IB %llx -> write %llx: fence %u %s, word %08x %s\n", ib, dst, fence,
+        done ? "done" : "NOT DONE", got, got == 0x5eed0506u ? "(GPU VIRTUAL ADDRESSING WORKS)" : "(wrong)");
+    if (!done || got != 0x5eed0506u) {
+        ocean_gpu_report("self-test");
+        return false;
+    }
+    return true;
+}
