+static void gpu_keep(vm_offset_t gpu, vm_offset_t gcc) {
+    uint32_t pm4_len = 0, pfp_len = 0;
+    uint64_t pm4 = ucode("pm4", &pm4_len), pfp = ucode("pfp", &pfp_len);
+    keep.gpu = gpu;
+    keep.smmu = ml_io_map(SMMU_PA, 0x10000);
+    keep.ring = gpu_alloc(GPU_RING_BYTES, &keep.ring_va);
+    keep.scratch = gpu_alloc(PAGE_SIZE, &keep.scratch_va);
+    if (!pm4 || !pfp || !keep.smmu || !keep.ring || !keep.scratch) {
+        printf("OCEAN GPU: keep: no microcode or memory\n");
+        return;
+    }
+    if (!smmu_setup() || !map_identity(pm4, round_page(pm4_len)) ||
+        !map_identity(pfp, round_page(pfp_len)) || !map_identity(keep.ring, GPU_RING_BYTES) ||
+        !map_identity(keep.scratch, PAGE_SIZE)) {
+        printf("OCEAN GPU: keep: GPU address space setup failed\n");
+        return;
+    }
+    ocean_gpu_mapped();
+    keep.free[0].start = GPU_VA_START;
+    keep.free[0].size = GPU_VA_END - GPU_VA_START;
+    keep.free_count = 1;
+    pause_s(2);
+
+    hw_init(gpu);
+    gw64(gpu, R_CP_ME_INSTR_BASE, pm4);
+    gw64(gpu, R_CP_PFP_INSTR_BASE, pfp);
+    gw64(gpu, R_CP_RB_BASE, keep.ring);
+    /* BUFSZ log2(32 KB / 8) = 12, BLKSZ 2, NO_UPDATE */
+    gw(gpu, R_CP_RB_CNTL, 12u | (2u << 8) | (1u << 27));
+    gw(gpu, R_CP_PFP_ME_CNTL, 0);
+    ring_word(pkt7(CP_ME_INIT, 8));
+    ring_word(0x2f);
+    ring_word(0x3);
+    ring_word(0x20000000);
+    ring_word(0);
+    ring_word(0);
+    ring_word(0xb);         /* A506/A530 token-end-sync workaround */
+    ring_word(0);
+    ring_word(0);
+    ring_send();
+    unsigned ms;
+    for (ms = 0; ms < 200 && gr(gpu, R_CP_RB_RPTR) != keep.ring_at; ms++) {
+        delay(1000);
+    }
+    /* No zap shader yet (TZ auth_and_reset -2): leave secure mode the way
+     * a5xx_hw_init does without one. */
+    gw(gpu, R_SECVID_TRUST_CNTL, 0);
+    cp_state(gpu, ms < 200 ? "keep: CP started through the SMMU:" : "keep: ME_INIT NOT consumed:");
+    if (ms >= 200) {
+        ocean_gpu_report("ME_INIT");
+        return;
+    }
+    (void)gcc;
+    if (!keep_selftest()) { return; }
+    keep.kept = true;
+    printf("OCEAN GPU: THE GPU STAYS ON for programs to draw with\n");
+}
